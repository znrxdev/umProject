@model List<UmProject.Entities.ReporteEvaluacion>

@{
    ViewData["Title"] = "Reporte de Evaluaciones";
    ViewData["Subtitle"] = "Evaluaciones Académicas";
    var tipoReporte = "evaluaciones";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <a asp-controller="Reportes" asp-action="Index">Reportes</a>
        <span class="separator">/</span>
        <span>@ViewData["Subtitle"]</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">@ViewData["Subtitle"]</h1>
            <p class="page-subtitle">Listado detallado de evaluaciones académicas del sistema</p>
        </div>
        <form asp-action="ExportarPdf" method="post" style="display: inline;">
            <input type="hidden" name="tipoReporte" value="@tipoReporte" />
            <input type="hidden" name="fechaInicio" value="@ViewBag.FechaInicio?.ToString("yyyy-MM-dd")" />
            <input type="hidden" name="fechaFin" value="@ViewBag.FechaFin?.ToString("yyyy-MM-dd")" />
            <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none; padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
                <i class="fas fa-file-pdf me-2"></i>Descargar PDF
            </button>
        </form>
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <div class="modern-table-container">
        @if (Model != null && Model.Any())
        {
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>Código Registro</th>
                        <th>Evaluación</th>
                        <th>Materia</th>
                        <th>Estudiante</th>
                        <th>Nombre Estudiante</th>
                        <th>Puntaje</th>
                        <th>Porcentaje</th>
                        <th>Estado</th>
                        <th>Fecha Creación</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evaluacion in Model)
                    {
                        <tr>
                            <td>@evaluacion.CodigoRegistro</td>
                            <td>@evaluacion.NombreEvaluacion</td>
                            <td>@evaluacion.NombreMateria</td>
                            <td>@evaluacion.Estudiante</td>
                            <td>@evaluacion.NombreEstudiante</td>
                            <td>@evaluacion.PuntajeObtenido</td>
                            <td>@evaluacion.PorcentajeLogrado</td>
                            <td>
                                @if (evaluacion.Estado != null && evaluacion.Estado.Trim().Equals("ACTIVO", StringComparison.OrdinalIgnoreCase))
                                {
                                    <span class="status-badge active">
                                        <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #10b981;"></i>@evaluacion.Estado
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">
                                        <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #ef4444;"></i>@evaluacion.Estado
                                    </span>
                                }
                            </td>
                            <td>@evaluacion.FechaCreacion</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-info-circle"></i>
                <h3>No hay datos para mostrar</h3>
                <p>No se encontraron evaluaciones para el período seleccionado.</p>
            </div>
        }
    </div>
</div>

