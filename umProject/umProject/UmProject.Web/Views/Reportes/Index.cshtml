@{
    ViewData["Title"] = "Reportes";
    ViewData["Subtitle"] = "Generación de reportes del sistema";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <span>Reportes</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">Reportes del Sistema</h1>
            <p class="page-subtitle">Genere y descargue reportes en formato PDF de todos los módulos del sistema</p>
        </div>
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <div class="row g-4">
        <!-- Filtros -->
        <div class="col-12">
            <div class="modern-table-container">
                <h5 class="mb-3" style="font-weight: 600; color: var(--text-primary);">
                    <i class="fas fa-filter me-2"></i>Filtros de Fecha
                </h5>
                <form asp-action="GenerarReporte" method="get" id="formFiltros" class="row g-3">
                    <div class="col-md-4">
                        <label for="fechaInicio" class="form-label">Fecha Inicio</label>
                        @{
                            var fechaMaxima = DateTime.Today.ToString("yyyy-MM-dd");
                        }
                        <input type="date" id="fechaInicio" name="fechaInicio" class="form-control" style="border: 1px solid var(--border-color);" max="@fechaMaxima">
                    </div>
                    <div class="col-md-4">
                        <label for="fechaFin" class="form-label">Fecha Fin</label>
                        <input type="date" id="fechaFin" name="fechaFin" class="form-control" style="border: 1px solid var(--border-color);" max="@fechaMaxima">
                    </div>
                    <div class="col-md-4 d-flex align-items-end">
                        <button type="button" class="btn btn-secondary" onclick="limpiarFiltros()" style="margin-right: 0.5rem;">
                            <i class="fas fa-times me-2"></i>Limpiar
                        </button>
                        <small class="text-muted align-self-center">Los filtros se aplicarán al seleccionar un reporte</small>
                    </div>
                </form>
            </div>
        </div>

        <!-- Lista de Reportes -->
        <div class="col-12">
            <div class="modern-table-container">
                <h5 class="mb-4" style="font-weight: 600; color: var(--text-primary);">
                    <i class="fas fa-chart-bar me-2"></i>Reportes Disponibles
                </h5>
                <div class="row g-3">
                    <!-- Usuarios -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px; transition: transform 0.2s, box-shadow 0.2s;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-users me-2" style="color: var(--primary-color);"></i>Usuarios
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reportes de usuarios del sistema</p>
                                <div class="d-grid gap-2">
                                    <a href="#" onclick="generarReporte('usuarios-activos'); return false;" class="btn btn-sm btn-outline-primary">
                                        <i class="fas fa-check-circle me-2"></i>Usuarios Activos
                                    </a>
                                    <a href="#" onclick="generarReporte('usuarios-inactivos'); return false;" class="btn btn-sm btn-outline-secondary">
                                        <i class="fas fa-times-circle me-2"></i>Usuarios Inactivos
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Personas -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-user me-2" style="color: var(--primary-color);"></i>Personas
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de personas registradas</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('personas'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Materias -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-book me-2" style="color: var(--primary-color);"></i>Materias
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de materias académicas</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('materias'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Períodos -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-calendar-alt me-2" style="color: var(--primary-color);"></i>Períodos Académicos
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de períodos académicos</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('periodos'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Secciones -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-layer-group me-2" style="color: var(--primary-color);"></i>Secciones
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de secciones académicas</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('secciones'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Grupos -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-users-cog me-2" style="color: var(--primary-color);"></i>Grupos
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de grupos académicos</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('grupos'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Inscripciones -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-clipboard-list me-2" style="color: var(--primary-color);"></i>Inscripciones
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de inscripciones académicas</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('inscripciones'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Evaluaciones -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-clipboard-check me-2" style="color: var(--primary-color);"></i>Evaluaciones
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de evaluaciones académicas</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('evaluaciones'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Becas - Programas -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-graduation-cap me-2" style="color: var(--primary-color);"></i>Programas de Becas
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de programas de becas</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('becas-programas'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Becas - Convocatorias -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-file-alt me-2" style="color: var(--primary-color);"></i>Convocatorias de Becas
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de convocatorias de becas</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('becas-convocatorias'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Becas - Solicitudes -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-hand-holding-usd me-2" style="color: var(--primary-color);"></i>Solicitudes de Becas
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de solicitudes de becas</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('becas-solicitudes'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Sanciones -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-exclamation-triangle me-2" style="color: var(--primary-color);"></i>Sanciones Académicas
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de sanciones académicas</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('sanciones'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Transacciones -->
                    <div class="col-md-6 col-lg-4">
                        <div class="card h-100" style="border: 1px solid var(--border-color); border-radius: 8px;">
                            <div class="card-body">
                                <h6 class="card-title" style="font-weight: 600; color: var(--text-primary);">
                                    <i class="fas fa-list-alt me-2" style="color: var(--primary-color);"></i>Transacciones
                                </h6>
                                <p class="card-text" style="font-size: 0.875rem; color: var(--text-secondary);">Reporte de transacciones del sistema</p>
                                <div class="d-grid">
                                    <a href="#" onclick="generarReporte('transacciones'); return false;" class="btn btn-sm btn-primary">
                                        <i class="fas fa-file-pdf me-2"></i>Generar Reporte
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function generarReporte(tipoReporte) {
            const fechaInicio = document.getElementById('fechaInicio').value;
            const fechaFin = document.getElementById('fechaFin').value;
            
            let url = '@Url.Action("GenerarReporte", "Reportes")?tipoReporte=' + tipoReporte;
            if (fechaInicio) {
                url += '&fechaInicio=' + fechaInicio;
            }
            if (fechaFin) {
                url += '&fechaFin=' + fechaFin;
            }
            
            window.location.href = url;
        }

        function limpiarFiltros() {
            document.getElementById('fechaInicio').value = '';
            document.getElementById('fechaFin').value = '';
        }
    </script>
}

