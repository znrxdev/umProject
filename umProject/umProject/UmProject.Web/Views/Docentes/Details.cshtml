@model UmProject.Entities.DocenteDetalle

@{
    ViewData["Title"] = "Detalles del Docente";
    ViewData["Subtitle"] = "Información completa del docente";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show m-3" role="alert" style="border-radius: 8px;">
        @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <a asp-controller="Docentes" asp-action="Index">Docentes</a>
        <span class="separator">/</span>
        <span>Detalles</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">@Model.NombreCompleto</h1>
            <p class="page-subtitle">@Model.Usuario - @Model.ValorDocumento</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 1.25rem; border-radius: 8px;">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>
</div>

<!-- Tabs Navigation -->
<ul class="nav nav-tabs mb-4" id="docenteTabs" role="tablist" style="border-bottom: 2px solid var(--border-color);">
    <li class="nav-item" role="presentation">
        <button class="nav-link active" id="general-tab" data-bs-toggle="tab" data-bs-target="#general" type="button" role="tab" 
                style="color: var(--text-primary); border: none; border-bottom: 2px solid var(--primary-color); padding: 0.75rem 1.5rem; font-weight: 500;">
            <i class="fas fa-info-circle me-2"></i>Información General
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="evaluaciones-tab" data-bs-toggle="tab" data-bs-target="#evaluaciones" type="button" role="tab"
                onclick="cargarEvaluaciones(@Model.IdUsuario)"
                style="color: var(--text-primary); border: none; padding: 0.75rem 1.5rem; font-weight: 500;">
            <i class="fas fa-clipboard-check me-2"></i>Evaluaciones Realizadas
        </button>
    </li>
    <li class="nav-item" role="presentation">
        <button class="nav-link" id="secciones-tab" data-bs-toggle="tab" data-bs-target="#secciones" type="button" role="tab"
                onclick="cargarSecciones(@Model.IdUsuario)"
                style="color: var(--text-primary); border: none; padding: 0.75rem 1.5rem; font-weight: 500;">
            <i class="fas fa-layer-group me-2"></i>Secciones Asignadas
        </button>
    </li>
</ul>

<!-- Tab Content -->
<div class="tab-content" id="docenteTabContent">
    <!-- Información General -->
    <div class="tab-pane fade show active" id="general" role="tabpanel">
        <div class="content-container">
            <div class="row">
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0"><i class="fas fa-user me-2"></i>Datos Personales</h6>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-4">Nombre Completo:</dt>
                                <dd class="col-sm-8">@Model.NombreCompleto</dd>
                                
                                <dt class="col-sm-4">Usuario:</dt>
                                <dd class="col-sm-8">@Model.Usuario</dd>
                                
                                <dt class="col-sm-4">Documento:</dt>
                                <dd class="col-sm-8">@Model.ValorDocumento</dd>
                                
                                <dt class="col-sm-4">Fecha de Nacimiento:</dt>
                                <dd class="col-sm-8">@(Model.FechaNacimiento?.ToString("dd/MM/yyyy") ?? "N/A")</dd>
                                
                                <dt class="col-sm-4">Estado:</dt>
                                <dd class="col-sm-8">
                                    @if (Model.EstadoUsuario != null && Model.EstadoUsuario.Trim().Equals("ACTIVO", StringComparison.OrdinalIgnoreCase))
                                    {
                                        <span class="status-badge active">
                                            <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #10b981;"></i>@Model.EstadoUsuario
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge inactive">
                                            <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #ef4444;"></i>@Model.EstadoUsuario
                                        </span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                </div>
                <div class="col-md-6">
                    <div class="card mb-3">
                        <div class="card-header">
                            <h6 class="mb-0"><i class="fas fa-chart-bar me-2"></i>Resumen Académico</h6>
                        </div>
                        <div class="card-body">
                            <dl class="row">
                                <dt class="col-sm-6">Secciones Activas:</dt>
                                <dd class="col-sm-6"><span class="badge bg-primary">@Model.TotalSeccionesActivas</span></dd>
                                
                                <dt class="col-sm-6">Evaluaciones Realizadas:</dt>
                                <dd class="col-sm-6"><span class="badge bg-success">@Model.TotalEvaluacionesRealizadas</span></dd>
                                
                                <dt class="col-sm-6">Estudiantes Activos:</dt>
                                <dd class="col-sm-6"><span class="badge bg-info">@Model.TotalEstudiantesActivos</span></dd>
                                
                                <dt class="col-sm-6">Período Actual:</dt>
                                <dd class="col-sm-6">@(Model.PeriodoActual ?? "N/A")</dd>
                                
                                <dt class="col-sm-6">Última Sesión:</dt>
                                <dd class="col-sm-6">@(Model.UltimaSesion?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>
                            </dl>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Evaluaciones Realizadas -->
    <div class="tab-pane fade" id="evaluaciones" role="tabpanel">
        <div class="content-container" id="evaluacionesContainer">
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>

    <!-- Secciones Asignadas -->
    <div class="tab-pane fade" id="secciones" role="tabpanel">
        <div class="content-container" id="seccionesContainer">
            <div class="text-center py-5">
                <div class="spinner-border text-primary" role="status">
                    <span class="visually-hidden">Cargando...</span>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Detalle de Evaluación -->
<div class="modal fade" id="detalleEvaluacionModal" tabindex="-1" aria-labelledby="detalleEvaluacionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="detalleEvaluacionModalLabel">
                    <i class="fas fa-clipboard-check me-2"></i>Detalle de Evaluación
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="detalleEvaluacionContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Estudiantes de Sección -->
<div class="modal fade" id="estudiantesSeccionModal" tabindex="-1" aria-labelledby="estudiantesSeccionModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-xl">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="estudiantesSeccionModalLabel">
                    <i class="fas fa-users me-2"></i>Estudiantes de la Sección
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body" id="estudiantesSeccionContent">
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status">
                        <span class="visually-hidden">Cargando...</span>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function cargarEvaluaciones(idUsuario) {
            if ($('#evaluacionesContainer').data('loaded')) return;
            
            $.ajax({
                url: '@Url.Action("Evaluaciones", "Docentes")',
                type: 'GET',
                data: { id: idUsuario },
                success: function(data) {
                    $('#evaluacionesContainer').html(data).data('loaded', true);
                    $('#evaluacionesContainer').data('docenteId', idUsuario);
                },
                error: function() {
                    $('#evaluacionesContainer').html('<div class="alert alert-danger">Error al cargar evaluaciones</div>');
                }
            });
        }

        function cargarSecciones(idUsuario) {
            if ($('#seccionesContainer').data('loaded')) return;
            
            $.ajax({
                url: '@Url.Action("Secciones", "Docentes")',
                type: 'GET',
                data: { id: idUsuario },
                success: function(data) {
                    $('#seccionesContainer').html(data).data('loaded', true);
                },
                error: function() {
                    $('#seccionesContainer').html('<div class="alert alert-danger">Error al cargar secciones</div>');
                }
            });
        }

        function verDetalleEvaluacion(idEvaluacion) {
            $('#detalleEvaluacionContent').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>');
            $('#detalleEvaluacionModal').modal('show');
            
            $.ajax({
                url: '@Url.Action("DetalleEvaluacion", "Docentes")',
                type: 'GET',
                data: { id: idEvaluacion },
                success: function(data) {
                    $('#detalleEvaluacionContent').html(data);
                },
                error: function() {
                    $('#detalleEvaluacionContent').html('<div class="alert alert-danger">Error al cargar el detalle de la evaluación</div>');
                }
            });
        }

        function verEstudiantesSeccion(idSeccion, codigoSeccion) {
            $('#estudiantesSeccionModalLabel').html('<i class="fas fa-users me-2"></i>Estudiantes - ' + codigoSeccion);
            $('#estudiantesSeccionContent').html('<div class="text-center py-5"><div class="spinner-border text-primary" role="status"><span class="visually-hidden">Cargando...</span></div></div>');
            $('#estudiantesSeccionModal').modal('show');
            
            $.ajax({
                url: '@Url.Action("EstudiantesSeccion", "Docentes")',
                type: 'GET',
                data: { id: idSeccion },
                success: function(data) {
                    $('#estudiantesSeccionContent').html(data);
                },
                error: function() {
                    $('#estudiantesSeccionContent').html('<div class="alert alert-danger">Error al cargar los estudiantes</div>');
                }
            });
        }

        // Manejar cambio de tabs
        $('#docenteTabs button').on('shown.bs.tab', function (e) {
            var target = $(e.target).data('bs-target');
            var idUsuario = @Model.IdUsuario;
            
            if (target === '#evaluaciones') cargarEvaluaciones(idUsuario);
            else if (target === '#secciones') cargarSecciones(idUsuario);
        });
    </script>
}

