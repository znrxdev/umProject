@model List<UmProject.Entities.DocenteSeccion>

@if (Model != null && Model.Any())
{
    <div class="modern-table-container">
        <div class="mb-3">
            <div class="row align-items-center">
                <div class="col-md-6">
                    <div class="search-input-wrapper">
                        <i class="fas fa-search"></i>
                        <input type="text" id="searchSecciones" placeholder="Buscar por materia, código..." class="form-control" style="border: 1px solid var(--border-color);">
                    </div>
                </div>
                <div class="col-md-6 text-end">
                    <span class="badge bg-info fs-6">Total: @Model.Count secciones</span>
                </div>
            </div>
        </div>
        <table class="modern-table" id="tablaSecciones">
            <thead>
                <tr>
                    <th>Código Sección</th>
                    <th>Materia</th>
                    <th>Período</th>
                    <th>Tipo</th>
                    <th>Aula</th>
                    <th>Modalidad</th>
                    <th>Cupo</th>
                    <th>Estudiantes</th>
                    <th>Estado</th>
                    <th>Acciones</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var seccion in Model)
                {
                    <tr>
                        <td><code>@seccion.CodigoSeccion</code></td>
                        <td>@seccion.NombreMateria <br><small class="text-muted">@seccion.CodigoMateria</small></td>
                        <td>@seccion.NombrePeriodo <br><small class="text-muted">@seccion.CodigoPeriodo</small></td>
                        <td>@seccion.TipoSeccion</td>
                        <td>@(seccion.Aula ?? "N/A")</td>
                        <td>@(seccion.Modalidad ?? "N/A")</td>
                        <td>
                            @if (seccion.CupoMaximo.HasValue)
                            {
                                <span class="badge @(seccion.TotalEstudiantes >= seccion.CupoMaximo ? "bg-danger" : "bg-success")">
                                    @seccion.TotalEstudiantes / @seccion.CupoMaximo
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-info">@seccion.TotalEstudiantes</span>
                            }
                        </td>
                        <td>
                            <span class="badge bg-primary">@seccion.TotalEstudiantes</span>
                        </td>
                        <td>
                            @if (seccion.EstadoSeccion != null && seccion.EstadoSeccion.Trim().Equals("ACTIVO", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status-badge active">
                                    <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #10b981;"></i>@seccion.EstadoSeccion
                                </span>
                            }
                            else
                            {
                                <span class="status-badge inactive">
                                    <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #ef4444;"></i>@seccion.EstadoSeccion
                                </span>
                            }
                        </td>
                        <td>
                            <button type="button" class="btn btn-sm btn-info" onclick="verEstudiantesSeccion(@seccion.IdSeccion, '@seccion.CodigoSeccion')" title="Ver estudiantes">
                                <i class="fas fa-users"></i> Ver Estudiantes
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-layer-group"></i>
        <h3>No hay secciones asignadas</h3>
        <p>El docente no tiene secciones asignadas actualmente.</p>
    </div>
}

<script>
    $(document).ready(function() {
        $('#searchSecciones').on('input', function() {
            var searchText = $(this).val().toLowerCase();
            $('#tablaSecciones tbody tr').each(function() {
                var rowText = $(this).text().toLowerCase();
                $(this).toggle(rowText.includes(searchText));
            });
        });
    });
</script>

