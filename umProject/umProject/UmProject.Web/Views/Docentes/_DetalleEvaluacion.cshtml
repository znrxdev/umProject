@model UmProject.Entities.DocenteEvaluacionDetalle

<div class="row">
    <!-- Información del Estudiante -->
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-primary text-white">
                <h6 class="mb-0"><i class="fas fa-user-graduate me-2"></i>Información del Estudiante</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Nombre:</dt>
                    <dd class="col-sm-7">@Model.NombreEstudiante</dd>
                    
                    <dt class="col-sm-5">Usuario:</dt>
                    <dd class="col-sm-7">@Model.UsuarioEstudiante</dd>
                    
                    <dt class="col-sm-5">Documento:</dt>
                    <dd class="col-sm-7">@Model.ValorDocumentoEstudiante</dd>
                    
                    <dt class="col-sm-5">Código Registro:</dt>
                    <dd class="col-sm-7"><code>@Model.CodigoRegistro</code></dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Instancia de Evaluación -->
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-info text-white">
                <h6 class="mb-0"><i class="fas fa-calendar-alt me-2"></i>Instancia de Evaluación</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Código Instancia:</dt>
                    <dd class="col-sm-7"><code>@Model.CodigoInstancia</code></dd>
                    
                    <dt class="col-sm-5">Fecha Programada:</dt>
                    <dd class="col-sm-7">@(Model.FechaProgramada?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>
                    
                    <dt class="col-sm-5">Fecha Límite:</dt>
                    <dd class="col-sm-7">@(Model.FechaLimite?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Modelo de Evaluación -->
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-secondary text-white">
                <h6 class="mb-0"><i class="fas fa-file-alt me-2"></i>Modelo de Evaluación</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Nombre:</dt>
                    <dd class="col-sm-7">@Model.NombreEvaluacion</dd>
                    
                    <dt class="col-sm-5">Código Modelo:</dt>
                    <dd class="col-sm-7"><code>@Model.CodigoModelo</code></dd>
                    
                    <dt class="col-sm-5">Tipo:</dt>
                    <dd class="col-sm-7">@Model.TipoEvaluacion</dd>
                    
                    <dt class="col-sm-5">Concepto:</dt>
                    <dd class="col-sm-7">@(Model.Concepto ?? "N/A")</dd>
                    
                    <dt class="col-sm-5">Calificación Máxima:</dt>
                    <dd class="col-sm-7"><span class="badge bg-dark">@Model.CalificacionMaxima.ToString("F2")</span></dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Materia y Sección -->
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-dark text-white">
                <h6 class="mb-0"><i class="fas fa-book me-2"></i>Materia y Sección</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Materia:</dt>
                    <dd class="col-sm-7">@Model.NombreMateria</dd>
                    
                    <dt class="col-sm-5">Código Materia:</dt>
                    <dd class="col-sm-7"><code>@Model.CodigoMateria</code></dd>
                    
                    <dt class="col-sm-5">Sección:</dt>
                    <dd class="col-sm-7"><code>@Model.CodigoSeccion</code></dd>
                    
                    <dt class="col-sm-5">Período:</dt>
                    <dd class="col-sm-7">@Model.NombrePeriodo (@Model.CodigoPeriodo)</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Resultado del Alumno -->
    <div class="col-md-12">
        <div class="card mb-3">
            <div class="card-header bg-success text-white">
                <h6 class="mb-0"><i class="fas fa-chart-line me-2"></i>Resultado del Alumno</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-3 text-center">
                        <h4 class="mb-0">@Model.PuntajeObtenido.ToString("F2")</h4>
                        <small class="text-muted">Puntaje Obtenido</small>
                    </div>
                    <div class="col-md-3 text-center">
                        @if (Model.PorcentajeLogrado.HasValue)
                        {
                            <h4 class="mb-0">
                                <span class="badge @(Model.PorcentajeLogrado >= 60 ? "bg-success" : "bg-danger") fs-5">
                                    @Model.PorcentajeLogrado.Value.ToString("F2")%
                                </span>
                            </h4>
                        }
                        else
                        {
                            <h4 class="mb-0 text-muted">N/A</h4>
                        }
                        <small class="text-muted">Porcentaje Logrado</small>
                    </div>
                    <div class="col-md-3 text-center">
                        @if (Model.PuntajeNormalizado.HasValue)
                        {
                            <h4 class="mb-0">@Model.PuntajeNormalizado.Value.ToString("F4")</h4>
                        }
                        else
                        {
                            <h4 class="mb-0 text-muted">N/A</h4>
                        }
                        <small class="text-muted">Puntaje Normalizado</small>
                    </div>
                    <div class="col-md-3 text-center">
                        @if (Model.EsRecalculo)
                        {
                            <h4 class="mb-0"><span class="badge bg-warning text-dark">Sí (#@Model.NumeroRecalculo)</span></h4>
                        }
                        else
                        {
                            <h4 class="mb-0"><span class="badge bg-secondary">No</span></h4>
                        }
                        <small class="text-muted">Es Recálculo</small>
                    </div>
                </div>
                
                @if (!string.IsNullOrEmpty(Model.MotivoAjuste))
                {
                    <hr />
                    <div class="row">
                        <div class="col-12">
                            <strong><i class="fas fa-edit me-2"></i>Motivo de Ajuste:</strong>
                            <p class="mb-0 mt-2">@Model.MotivoAjuste</p>
                        </div>
                    </div>
                }
                
                @if (!string.IsNullOrEmpty(Model.Observaciones))
                {
                    <hr />
                    <div class="row">
                        <div class="col-12">
                            <strong><i class="fas fa-sticky-note me-2"></i>Observaciones:</strong>
                            <p class="mb-0 mt-2">@Model.Observaciones</p>
                        </div>
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Usuarios Involucrados -->
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-warning text-dark">
                <h6 class="mb-0"><i class="fas fa-users me-2"></i>Usuarios Involucrados</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Evaluado Por:</dt>
                    <dd class="col-sm-7">
                        @if (!string.IsNullOrEmpty(Model.NombreEvaluador))
                        {
                            @Model.NombreEvaluador <br><small class="text-muted">(@Model.UsuarioEvaluador)</small>
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </dd>
                    
                    <dt class="col-sm-5">Validado Por:</dt>
                    <dd class="col-sm-7">
                        @if (!string.IsNullOrEmpty(Model.NombreValidador))
                        {
                            @Model.NombreValidador <br><small class="text-muted">(@Model.UsuarioValidador)</small>
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </dd>
                    
                    <dt class="col-sm-5">Fecha Validación:</dt>
                    <dd class="col-sm-7">@(Model.FechaValidacion?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Estados y Firma -->
    <div class="col-md-6">
        <div class="card mb-3">
            <div class="card-header bg-danger text-white">
                <h6 class="mb-0"><i class="fas fa-check-circle me-2"></i>Estados y Firma</h6>
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-5">Estado Evaluación:</dt>
                    <dd class="col-sm-7">
                        @if (Model.EstadoEvaluacion != null && Model.EstadoEvaluacion.Trim().Equals("ACTIVO", StringComparison.OrdinalIgnoreCase))
                        {
                            <span class="badge bg-success">@Model.EstadoEvaluacion</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.EstadoEvaluacion</span>
                        }
                    </dd>
                    
                    <dt class="col-sm-5">Estado Publicación:</dt>
                    <dd class="col-sm-7">
                        @if (Model.EstadoPublicacion != null)
                        {
                            <span class="badge bg-info">@Model.EstadoPublicacion</span>
                        }
                        else
                        {
                            <span class="text-muted">N/A</span>
                        }
                    </dd>
                    
                    <dt class="col-sm-5">Firmado por Estudiante:</dt>
                    <dd class="col-sm-7">
                        @if (Model.FirmadoPorEstudiante)
                        {
                            <span class="badge bg-success"><i class="fas fa-check me-1"></i>Sí</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary"><i class="fas fa-times me-1"></i>No</span>
                        }
                    </dd>
                    
                    @if (!string.IsNullOrEmpty(Model.FirmaDigital))
                    {
                        <dt class="col-sm-5">Firma Digital:</dt>
                        <dd class="col-sm-7"><code class="small">@Model.FirmaDigital</code></dd>
                    }
                    
                    <dt class="col-sm-5">Fecha Notificación:</dt>
                    <dd class="col-sm-7">@(Model.FechaNotificacion?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>
                    
                    <dt class="col-sm-5">Fecha Publicación:</dt>
                    <dd class="col-sm-7">@(Model.FechaPublicacionResultado?.ToString("dd/MM/yyyy HH:mm") ?? "N/A")</dd>
                </dl>
            </div>
        </div>
    </div>

    <!-- Auditoría -->
    <div class="col-md-12">
        <div class="card">
            <div class="card-header bg-light">
                <h6 class="mb-0"><i class="fas fa-history me-2"></i>Información de Auditoría</h6>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-6">
                        <small class="text-muted">Fecha de Creación:</small>
                        <p class="mb-0">@(Model.FechaCreacion?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</p>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted">Última Modificación:</small>
                        <p class="mb-0">@(Model.FechaModificacion?.ToString("dd/MM/yyyy HH:mm:ss") ?? "N/A")</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

