@model UmProject.Entities.Seccion

@{
    ViewData["Title"] = "Editar Sección";
    ViewData["Subtitle"] = "Modificar información de sección";
    var modalidadCatalogoId = 0;
    if (!string.IsNullOrEmpty(Model.Modalidad) && ViewBag.Modalidades != null)
    {
        var modalidadCatalogo = (ViewBag.Modalidades as List<UmProject.Entities.Catalogo>)?.FirstOrDefault(m => m.NombreCatalogo?.ToUpper() == Model.Modalidad.ToUpper());
        if (modalidadCatalogo != null)
        {
            modalidadCatalogoId = modalidadCatalogo.IdCatalogo ?? 0;
        }
    }
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <a asp-controller="Secciones" asp-action="Index">Secciones</a>
        <span class="separator">/</span>
        <span>Editar</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">Editar Sección</h1>
            <p class="page-subtitle">Modifique la información de la sección</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <!-- Tabs Navigation -->
    <ul class="nav nav-tabs mb-3" id="seccionTabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link active" id="info-tab" data-bs-toggle="tab" data-bs-target="#info" type="button" role="tab">
                <i class="fas fa-info-circle me-2"></i>Información General
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="grupos-tab" data-bs-toggle="tab" data-bs-target="#grupos" type="button" role="tab">
                <i class="fas fa-users me-2"></i>Asignar Grupos
            </button>
        </li>
    </ul>

    <div class="tab-content" id="seccionTabContent">
        <!-- Tab: Información General -->
        <div class="tab-pane fade show active" id="info" role="tabpanel">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-edit me-2"></i>Información de la Sección</h6>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post" id="formEditarSeccion">
                        <input type="hidden" asp-for="IdSeccion" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="CodigoSeccion" class="form-label">Código de Sección <span class="text-danger">*</span></label>
                                <input asp-for="CodigoSeccion" class="form-control" placeholder="Ej: MAT-101-A" maxlength="20" required />
                                <span asp-validation-for="CodigoSeccion" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="IdMateriaPeriodo" class="form-label">Materia-Período <span class="text-danger">*</span></label>
                                <!-- Bloqueado en edición para evitar inconsistencias -->
                                <select class="form-select" id="IdMateriaPeriodo" disabled>
                                    <option value="">Seleccione una materia-período</option>
                                    @if (ViewBag.MateriasPeriodos != null)
                                    {
                                        @foreach (var mp in ViewBag.MateriasPeriodos as List<object>)
                                        {
                                            var mpDict = mp as dynamic;
                                            var isSelected = Model.IdMateriaPeriodo == mpDict.IdMateriaPeriodo;
                                            <option value="@mpDict.IdMateriaPeriodo" selected="@isSelected">@mpDict.DisplayText</option>
                                        }
                                    }
                                </select>
                                <!-- Preservar el valor real para el post -->
                                <input type="hidden" asp-for="IdMateriaPeriodo" />
                                <small class="form-text text-muted">La materia-período no puede modificarse una vez creada la sección.</small>
                                <span asp-validation-for="IdMateriaPeriodo" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdDocente" class="form-label">Docente <span class="text-danger">*</span></label>
                                <select asp-for="IdDocente" class="form-select" required>
                                    <option value="">Seleccione un docente</option>
                                    @if (ViewBag.Docentes != null)
                                    {
                                        @foreach (var docente in ViewBag.Docentes as List<UmProject.Entities.Docente>)
                                        {
                                            <option value="@docente.IdUsuario" selected="@(Model.IdDocente == docente.IdUsuario)">@docente.NombreCompleto - @docente.Usuario</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="IdDocente" class="text-danger"></span>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="IdTipoSeccion" class="form-label">Tipo de Sección <span class="text-danger">*</span></label>
                                <select asp-for="IdTipoSeccion" class="form-select" required>
                                    <option value="">Seleccione un tipo</option>
                                    @if (ViewBag.TiposSeccion != null)
                                    {
                                        @foreach (var tipo in ViewBag.TiposSeccion as List<UmProject.Entities.Catalogo>)
                                        {
                                            <option value="@tipo.IdCatalogo" selected="@(Model.IdTipoSeccion == tipo.IdCatalogo)">@tipo.NombreCatalogo</option>
                                        }
                                    }
                                </select>
                                <span asp-validation-for="IdTipoSeccion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label asp-for="IdAula" class="form-label">Aula</label>
                                <select asp-for="IdAula" class="form-select">
                                    <option value="">Seleccione un aula (opcional)</option>
                                    @if (ViewBag.Aulas != null)
                                    {
                                        @foreach (var aula in ViewBag.Aulas as List<UmProject.Entities.Catalogo>)
                                        {
                                            <option value="@aula.IdCatalogo" selected="@(Model.IdAula == aula.IdCatalogo)">@aula.NombreCatalogo</option>
                                        }
                                    }
                                </select>
                            </div>

                            <div class="col-md-6 mb-3">
                                <label asp-for="Modalidad" class="form-label">Modalidad</label>
                                <select name="IdModalidadCatalogo" id="IdModalidadCatalogo" class="form-select">
                                    <option value="">Seleccione una modalidad</option>
                                    @if (ViewBag.Modalidades != null)
                                    {
                                        @foreach (var modalidad in ViewBag.Modalidades as List<UmProject.Entities.Catalogo>)
                                        {
                                            <option value="@modalidad.IdCatalogo" selected="@(modalidadCatalogoId == modalidad.IdCatalogo)">@modalidad.NombreCatalogo</option>
                                        }
                                    }
                                </select>
                                <input type="hidden" asp-for="Modalidad" id="Modalidad" />
                                <span asp-validation-for="Modalidad" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="HorarioDescripcion" class="form-label">Descripción del Horario</label>
                                <input asp-for="HorarioDescripcion" class="form-control" placeholder="Ej: Lunes y Miércoles 8:00-10:00" maxlength="255" />
                                <span asp-validation-for="HorarioDescripcion" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-4 mb-3">
                                <label asp-for="CupoMaximo" class="form-label">Cupo Máximo</label>
                                <input asp-for="CupoMaximo" type="number" class="form-control" id="CupoMaximo" min="1" />
                                <span asp-validation-for="CupoMaximo" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="PorcentajeAsistenciaMinima" class="form-label">% Asistencia Mínima</label>
                                <input asp-for="PorcentajeAsistenciaMinima" type="number" step="0.01" class="form-control" min="0" max="100" />
                                <span asp-validation-for="PorcentajeAsistenciaMinima" class="text-danger"></span>
                            </div>

                            <div class="col-md-4 mb-3">
                                <label asp-for="IdEstado" class="form-label">
                                    @if (Model.IdEstado == 4)
                                    {
                                        <span>Estado Actual: EN REVISION</span>
                                    }
                                    else
                                    {
                                        <span>Estado Actual: @(Model.EstadoNombre ?? "N/A")</span>
                                    }
                                    <span class="text-danger">*</span>
                                </label>
                                <select asp-for="IdEstado" class="form-select" required>
                                    <option value="">Seleccione un estado</option>
                                    @if (ViewBag.Estados != null)
                                    {
                                        @foreach (var estado in ViewBag.Estados as List<UmProject.Entities.Estado>)
                                        {
                                            <option value="@estado.IdEstado" selected="@(Model.IdEstado == estado.IdEstado)">@estado.NombreEstado</option>
                                        }
                                    }
                                </select>
                                @if (Model.IdEstado == 4)
                                {
                                    <small class="form-text text-warning">
                                        <i class="fas fa-exclamation-triangle me-1"></i>
                                        Favor seleccionar un estado ACTIVO para activar la sección (prácticamente a ser aprobada).
                                    </small>
                                }
                                <span asp-validation-for="IdEstado" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <div class="form-check">
                                    <input type="checkbox" name="RequiereAsistencia" value="true" class="form-check-input" id="RequiereAsistencia" @(Model.RequiereAsistencia == true ? "checked" : "") />
                                    <input type="hidden" name="RequiereAsistencia" value="false" />
                                    <label class="form-check-label" for="RequiereAsistencia">
                                        Requiere Asistencia
                                    </label>
                                </div>
                            </div>
                        </div>

                        <div class="row">
                            <div class="col-md-12 mb-3">
                                <label asp-for="Observaciones" class="form-label">Observaciones</label>
                                <textarea asp-for="Observaciones" class="form-control" rows="3" maxlength="255" placeholder="Observaciones adicionales..."></textarea>
                                <span asp-validation-for="Observaciones" class="text-danger"></span>
                            </div>
                        </div>

                        <div class="d-flex gap-2 mt-4">
                            <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none; padding: 0.625rem 1.5rem; border-radius: 8px; font-weight: 600;">
                                <i class="fas fa-save me-2"></i>Guardar Cambios
                            </button>
                            <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 1.5rem; border-radius: 8px; font-weight: 600;">
                                <i class="fas fa-times me-2"></i>Cancelar
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>

        <!-- Tab: Asignar Grupos -->
        <div class="tab-pane fade" id="grupos" role="tabpanel">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); color: white; border-radius: 12px 12px 0 0 !important;">
                    <h6 class="mb-0" style="color: white; font-weight: 600;"><i class="fas fa-users me-2"></i>Asignar Grupos a la Sección</h6>
                </div>
                <div class="card-body">
                    <div id="gruposContainer">
                        <div class="text-center py-4">
                            <div class="spinner-border text-primary" role="status">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <p class="text-muted mt-2">Cargando grupos disponibles...</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Aumentar Cupo -->
<div class="modal fade" id="modalAumentarCupo" tabindex="-1" aria-labelledby="modalAumentarCupoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); color: white;">
                <h5 class="modal-title" id="modalAumentarCupoLabel" style="color: white;">
                    <i class="fas fa-arrow-up me-2"></i>Aumentar Cupo Máximo
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formAumentarCupo">
                    <input type="hidden" id="idGrupoAumentarCupo" />
                    <div class="mb-3">
                        <label for="cupoActual" class="form-label">Cupo Actual</label>
                        <input type="number" class="form-control" id="cupoActual" readonly style="background-color: #e9ecef;" />
                    </div>
                    <div class="mb-3">
                        <label for="nuevoCupo" class="form-label">Nuevo Cupo Máximo <span class="text-danger">*</span></label>
                        <input type="number" class="form-control" id="nuevoCupo" min="1" required />
                        <small class="form-text text-muted">El nuevo cupo debe ser mayor o igual al número de inscripciones del grupo.</small>
                    </div>
                    <div class="alert alert-info">
                        <i class="fas fa-info-circle me-2"></i>
                        <strong>Nota:</strong> Al aumentar el cupo máximo, se actualizará automáticamente en la base de datos.
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmarAumentarCupo">
                    <i class="fas fa-check me-1"></i>Confirmar
                </button>
            </div>
        </div>
    </div>
</div>

<!-- Modal para Desasignar Grupo -->
<div class="modal fade" id="modalDesasignarGrupo" tabindex="-1" aria-labelledby="modalDesasignarGrupoLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header" style="background: linear-gradient(135deg, #dc3545 0%, #c82333 100%); color: white;">
                <h5 class="modal-title" id="modalDesasignarGrupoLabel" style="color: white;">
                    <i class="fas fa-times-circle me-2"></i>Desasignar Grupo
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form id="formDesasignarGrupo">
                    <input type="hidden" id="idGrupoSeccionDesasignar" />
                    <div class="alert alert-warning">
                        <i class="fas fa-exclamation-triangle me-2"></i>
                        <strong>Advertencia:</strong> Al desasignar este grupo, la sección cambiará su estado a INACTIVO.
                    </div>
                    <div class="mb-3">
                        <label for="motivoDesasignacion" class="form-label">Motivo de Desasignación <span class="text-danger">*</span></label>
                        <textarea class="form-control" id="motivoDesasignacion" rows="3" maxlength="255" required placeholder="Ingrese el motivo de la desasignación..."></textarea>
                        <small class="form-text text-muted">Este motivo será registrado en el historial de la asignación.</small>
                    </div>
                    <div id="mensajeValidacionPeriodo" class="alert alert-danger" style="display: none;">
                        <i class="fas fa-ban me-2"></i>
                        <span id="textoValidacionPeriodo"></span>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-danger" id="btnConfirmarDesasignar">
                    <i class="fas fa-check me-1"></i>Confirmar Desasignación
                </button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        $(document).ready(function() {
            var idSeccion = @Model.IdSeccion;
            var idMateriaPeriodo = @(Model.IdMateriaPeriodo ?? 0);
            var cupoMaximo = @(Model.CupoMaximo ?? 0);

            // Mapear modalidad desde catálogo a texto
            $('#IdModalidadCatalogo').on('change', function() {
                var selectedOption = $(this).find('option:selected');
                var modalidadTexto = selectedOption.text();
                $('#Modalidad').val(modalidadTexto);
            });

            // Inicializar modalidad si hay valor
            if ($('#IdModalidadCatalogo').val()) {
                var selectedOption = $('#IdModalidadCatalogo').find('option:selected');
                $('#Modalidad').val(selectedOption.text());
            }

            // Cargar grupos cuando se activa el tab
            $('#grupos-tab').on('shown.bs.tab', function() {
                if (idMateriaPeriodo > 0) {
                    cargarGruposDisponibles();
                } else {
                    $('#gruposContainer').html('<div class="alert alert-warning"><i class="fas fa-exclamation-triangle me-2"></i>Debe seleccionar una materia-período para ver los grupos disponibles.</div>');
                }
            });

            // Función para cargar grupos disponibles
            function cargarGruposDisponibles() {
                $.ajax({
                    url: '@Url.Action("GetGruposPorMateriaPeriodo", "Secciones")',
                    type: 'GET',
                    data: { 
                        idMateriaPeriodo: idMateriaPeriodo,
                        idSeccion: idSeccion
                    },
                    success: function(response) {
                        if (response.success) {
                            mostrarGrupos(response.grupos, response.gruposAsignados);
                        } else {
                            $('#gruposContainer').html('<div class="alert alert-danger">' + response.message + '</div>');
                        }
                    },
                    error: function() {
                        $('#gruposContainer').html('<div class="alert alert-danger">Error al cargar los grupos disponibles.</div>');
                    }
                });
            }

            // Función para mostrar grupos
            function mostrarGrupos(grupos, gruposAsignados) {
                var idsGruposAsignados = gruposAsignados.map(function(ga) { return ga.IdGrupo || ga.idGrupo; });
                // Mostrar todos los grupos (tanto asignados como disponibles) en la misma tabla
                var todosLosGrupos = grupos;
                
                var html = '';
                
                if (todosLosGrupos.length === 0) {
                    html += '<div class="empty-state">';
                    html += '<i class="fas fa-users-slash fa-3x mb-3" style="color: var(--text-secondary); opacity: 0.5;"></i>';
                    html += '<h3>No hay grupos disponibles</h3>';
                    html += '<p>No hay grupos disponibles para este período académico.</p>';
                    html += '</div>';
                } else {
                    html += '<div class="modern-table-container">';
                    html += '<table class="modern-table">';
                    html += '<thead>';
                    html += '<tr>';
                    html += '<th>Grupo</th>';
                    html += '<th>Período</th>';
                    html += '<th>Inscripciones</th>';
                    html += '<th>Cupo Máximo</th>';
                    html += '<th style="text-align: right;">Acciones</th>';
                    html += '</tr>';
                    html += '</thead>';
                    html += '<tbody>';
                    
                    todosLosGrupos.forEach(function(grupo) {
                        var codigoGrupo = grupo.CodigoGrupo || grupo.codigoGrupo || '';
                        var nombreGrupo = grupo.NombreGrupo || grupo.nombreGrupo || '';
                        var codigoPeriodo = grupo.CodigoPeriodo || grupo.codigoPeriodo || '';
                        var cantidadInscripciones = grupo.CantidadInscripciones || grupo.cantidadInscripciones || 0;
                        var idGrupo = grupo.IdGrupo || grupo.idGrupo || 0;
                        var excedeCupo = cantidadInscripciones > cupoMaximo;
                        
                        // Verificar si el grupo ya está asignado
                        var grupoAsignado = gruposAsignados.find(function(ga) {
                            return (ga.IdGrupo || ga.idGrupo) === idGrupo;
                        });
                        var estaAsignado = grupoAsignado != null;
                        var idGrupoSeccion = estaAsignado ? (grupoAsignado.IdGrupoSeccion || grupoAsignado.idGrupoSeccion || 0) : 0;
                        
                        html += '<tr>';
                        html += '<td>';
                        if (estaAsignado) {
                            html += '<strong style="color: var(--primary-color);">' + (codigoGrupo ? codigoGrupo + ' - ' : '') + nombreGrupo + '</strong>';
                        } else {
                            html += (codigoGrupo ? codigoGrupo + ' - ' : '') + nombreGrupo;
                        }
                        html += '</td>';
                        html += '<td>' + codigoPeriodo + '</td>';
                        html += '<td><span class="badge ' + (excedeCupo ? 'bg-danger' : 'bg-info') + '">' + cantidadInscripciones + '</span></td>';
                        html += '<td>';
                        if (cupoMaximo) {
                            html += '<span style="font-weight: 500;">' + cupoMaximo + '</span>';
                        } else {
                            html += '<span class="text-muted">-</span>';
                        }
                        html += '</td>';
                        html += '<td style="text-align: right;">';
                        html += '<div class="action-buttons">';
                        
                        if (estaAsignado) {
                            // Grupo ya asignado
                            html += '<span class="badge bg-success me-2">Asignado</span>';
                            html += '<button type="button" class="btn-action btn-delete" onclick="desasignarGrupo(' + idGrupoSeccion + ')" title="Desasignar grupo">';
                            html += '<i class="fas fa-times"></i>';
                            html += '</button>';
                        } else if (excedeCupo) {
                            // Grupo disponible pero excede cupo
                            html += '<div class="d-flex flex-column gap-2 align-items-end">';
                            html += '<div class="alert alert-warning mb-0 py-2 px-3" style="font-size: 0.875rem; max-width: 300px;">';
                            html += '<i class="fas fa-exclamation-triangle me-1"></i>';
                            html += '<strong>Advertencia:</strong> Este grupo tiene ' + cantidadInscripciones + ' inscripciones, que supera el cupo máximo (' + cupoMaximo + ').';
                            html += '</div>';
                            html += '<button type="button" class="btn-action btn-edit" onclick="mostrarModalAumentarCupo(' + idGrupo + ', ' + cantidadInscripciones + ')" title="Aumentar cupo">';
                            html += '<i class="fas fa-arrow-up me-1"></i>Aumentar Cupo';
                            html += '</button>';
                            html += '</div>';
                        } else {
                            // Grupo disponible para asignar
                            html += '<button type="button" class="btn-action btn-view" onclick="asignarGrupo(' + idGrupo + ')" title="Asignar grupo">';
                            html += '<i class="fas fa-plus me-1"></i>Asignar';
                            html += '</button>';
                        }
                        
                        html += '</div>';
                        html += '</td>';
                        html += '</tr>';
                    });
                    
                    html += '</tbody>';
                    html += '</table>';
                    html += '</div>';
                }
                
                $('#gruposContainer').html(html);
            }

            // Función para asignar grupo
            window.asignarGrupo = function(idGrupo) {
                $.ajax({
                    url: '@Url.Action("AsignarGrupoSeccion", "Secciones")',
                    type: 'POST',
                    data: {
                        idSeccion: idSeccion,
                        idGrupo: idGrupo
                    },
                    success: function(response) {
                        if (response.success) {
                            if (typeof Notificaciones !== 'undefined') {
                                Notificaciones.exito('Grupo asignado exitosamente.');
                            } else {
                                alert('Grupo asignado exitosamente.');
                            }
                            cargarGruposDisponibles();
                        } else {
                            if (typeof Notificaciones !== 'undefined') {
                                Notificaciones.error(response.message || 'Error al asignar el grupo.');
                            } else {
                                alert('Error: ' + (response.message || 'Error desconocido'));
                            }
                        }
                    },
                    error: function() {
                        if (typeof Notificaciones !== 'undefined') {
                            Notificaciones.error('Error al asignar el grupo.');
                        } else {
                            alert('Error al asignar el grupo.');
                        }
                    }
                });
            };

            // Función para mostrar modal de aumentar cupo
            window.mostrarModalAumentarCupo = function(idGrupo, cantidadInscripciones) {
                $('#idGrupoAumentarCupo').val(idGrupo);
                $('#cupoActual').val(cupoMaximo);
                $('#nuevoCupo').val(cantidadInscripciones);
                $('#nuevoCupo').attr('min', cantidadInscripciones);
                $('#modalAumentarCupo').modal('show');
            };

            // Confirmar aumento de cupo
            $('#btnConfirmarAumentarCupo').on('click', function() {
                var nuevoCupo = parseInt($('#nuevoCupo').val());
                var cantidadInscripciones = parseInt($('#nuevoCupo').attr('min'));
                
                if (!nuevoCupo || nuevoCupo < cantidadInscripciones) {
                    if (typeof Notificaciones !== 'undefined') {
                        Notificaciones.error('El nuevo cupo debe ser mayor o igual a ' + cantidadInscripciones + ' (número de inscripciones del grupo).');
                    } else {
                        alert('El nuevo cupo debe ser mayor o igual a ' + cantidadInscripciones + ' (número de inscripciones del grupo).');
                    }
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("ActualizarCupoSeccion", "Secciones")',
                    type: 'POST',
                    data: {
                        idSeccion: idSeccion,
                        cupoMaximo: nuevoCupo
                    },
                    success: function(response) {
                        if (response.success) {
                            $('#modalAumentarCupo').modal('hide');
                            if (typeof Notificaciones !== 'undefined') {
                                Notificaciones.exito('Cupo máximo actualizado exitosamente a ' + nuevoCupo + '.');
                            } else {
                                alert('Cupo máximo actualizado exitosamente a ' + nuevoCupo + '.');
                            }
                            cupoMaximo = nuevoCupo;
                            $('#CupoMaximo').val(nuevoCupo);
                            cargarGruposDisponibles();
                        } else {
                            if (typeof Notificaciones !== 'undefined') {
                                Notificaciones.error(response.message || 'Error al actualizar el cupo máximo.');
                            } else {
                                alert('Error: ' + (response.message || 'Error desconocido'));
                            }
                        }
                    },
                    error: function() {
                        if (typeof Notificaciones !== 'undefined') {
                            Notificaciones.error('Error al actualizar el cupo máximo. Por favor, intente nuevamente.');
                        } else {
                            alert('Error al actualizar el cupo máximo. Por favor, intente nuevamente.');
                        }
                    }
                });
            });

            // Función para mostrar modal de desasignar grupo
            window.desasignarGrupo = function(idGrupoSeccion) {
                if (!idGrupoSeccion || idGrupoSeccion === 0) {
                    alert('Error: No se pudo identificar el grupo a desasignar.');
                    return;
                }
                
                $('#idGrupoSeccionDesasignar').val(idGrupoSeccion);
                $('#motivoDesasignacion').val('');
                $('#mensajeValidacionPeriodo').hide();
                $('#modalDesasignarGrupo').modal('show');
            };

            // Validar período antes de confirmar desasignación
            $('#modalDesasignarGrupo').on('show.bs.modal', function() {
                var idGrupoSeccion = $('#idGrupoSeccionDesasignar').val();
                if (idGrupoSeccion) {
                    $.ajax({
                        url: '@Url.Action("ValidarPeriodoActivo", "Secciones")',
                        type: 'GET',
                        data: { idSeccion: idSeccion },
                        success: function(response) {
                            if (response.success && !response.puedeDesasignar) {
                                $('#mensajeValidacionPeriodo').show();
                                $('#textoValidacionPeriodo').text(response.mensaje);
                                $('#btnConfirmarDesasignar').prop('disabled', true);
                            } else {
                                $('#mensajeValidacionPeriodo').hide();
                                $('#btnConfirmarDesasignar').prop('disabled', false);
                            }
                        },
                        error: function() {
                            $('#mensajeValidacionPeriodo').hide();
                            $('#btnConfirmarDesasignar').prop('disabled', false);
                        }
                    });
                }
            });

            // Confirmar desasignación
            $('#btnConfirmarDesasignar').on('click', function() {
                var idGrupoSeccion = $('#idGrupoSeccionDesasignar').val();
                var motivo = $('#motivoDesasignacion').val();
                
                if (!motivo || motivo.trim() === '') {
                    if (typeof Notificaciones !== 'undefined') {
                        Notificaciones.error('Debe ingresar un motivo para la desasignación.');
                    } else {
                        alert('Debe ingresar un motivo para la desasignación.');
                    }
                    return;
                }
                
                if ($('#btnConfirmarDesasignar').prop('disabled')) {
                    return;
                }
                
                $.ajax({
                    url: '@Url.Action("DesasignarGrupoSeccion", "Secciones")',
                    type: 'POST',
                    data: {
                        idGrupoSeccion: idGrupoSeccion,
                        motivo: motivo
                    },
                    success: function(response) {
                        if (response.success) {
                            $('#modalDesasignarGrupo').modal('hide');
                            if (typeof Notificaciones !== 'undefined') {
                                Notificaciones.exito('Grupo desasignado exitosamente. La sección ha cambiado su estado a INACTIVO.');
                            } else {
                                alert('Grupo desasignado exitosamente. La sección ha cambiado su estado a INACTIVO.');
                            }
                            cargarGruposDisponibles();
                        } else {
                            // Validar si el error es por período activo
                            var mensajeError = response.message || 'Error desconocido';
                            if (mensajeError.toLowerCase().includes('período académico') || mensajeError.toLowerCase().includes('periodo academico') || mensajeError.toLowerCase().includes('en curso') || mensajeError.toLowerCase().includes('activo')) {
                                if (typeof Notificaciones !== 'undefined') {
                                    Notificaciones.error(mensajeError, 'No se puede desasignar');
                                } else {
                                    alert('Error: ' + mensajeError);
                                }
                            } else {
                                if (typeof Notificaciones !== 'undefined') {
                                    Notificaciones.error(mensajeError);
                                } else {
                                    alert('Error: ' + mensajeError);
                                }
                            }
                        }
                    },
                    error: function(xhr) {
                        console.error('Error al desasignar:', xhr);
                        var mensajeError = 'Error al desasignar el grupo. Por favor, intente nuevamente.';
                        if (xhr.responseJSON && xhr.responseJSON.message) {
                            mensajeError = xhr.responseJSON.message;
                        }
                        if (typeof Notificaciones !== 'undefined') {
                            Notificaciones.error(mensajeError);
                        } else {
                            alert(mensajeError);
                        }
                    }
                });
            });

            // Función para mostrar modal de asignar grupo (si se necesita en el futuro)
            window.mostrarModalAsignarGrupo = function() {
                // Por ahora, simplemente hacer scroll a la sección de grupos disponibles
                $('html, body').animate({
                    scrollTop: $('#gruposContainer').offset().top - 100
                }, 500);
            };
        });
    </script>

