@model UmProject.Entities.EvaluacionInstancia

@{
    ViewData["Title"] = "Editar Instancia de Evaluación";
    ViewData["Subtitle"] = "Modificar información de instancia";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <a asp-controller="ConfiguracionEvaluaciones" asp-action="Index">Configuración de Evaluaciones</a>
        <span class="separator">/</span>
        <span>Editar</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">Editar Instancia de Evaluación</h1>
            <p class="page-subtitle">Modifique la información de la instancia</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <div class="card">
        <div class="card-header">
            <h6 class="mb-0"><i class="fas fa-edit me-2"></i>Información de la Instancia</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="IdEvaluacionInstancia" />
                @if (!ViewContext.ModelState.IsValid)
                {
                    <div asp-validation-summary="All" class="alert alert-danger"></div>
                }

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CodigoInstancia" class="form-label">Código de Instancia <span class="text-danger">*</span></label>
                        <input asp-for="CodigoInstancia" class="form-control" maxlength="30" required />
                        <span asp-validation-for="CodigoInstancia" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdSeccion" class="form-label">Sección <span class="text-danger">*</span></label>
                        <select asp-for="IdSeccion" class="form-select" required>
                            <option value="">Seleccione una sección</option>
                            @if (ViewBag.Secciones != null)
                            {
                                @foreach (var seccion in ViewBag.Secciones as List<UmProject.Entities.Seccion>)
                                {
                                    <option value="@seccion.IdSeccion" selected="@(seccion.IdSeccion == Model.IdSeccion)">@(seccion.CodigoSeccion ?? "") - @(seccion.NombreMateria ?? "")</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdSeccion" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdEvaluacionModelo" class="form-label">Modelo de Evaluación <span class="text-danger">*</span></label>
                        <select asp-for="IdEvaluacionModelo" class="form-select" required>
                            <option value="">Seleccione un modelo de evaluación</option>
                            @if (ViewBag.ModelosEvaluacion != null)
                            {
                                @foreach (var modelo in ViewBag.ModelosEvaluacion as List<UmProject.Entities.EvaluacionModelo>)
                                {
                                    <option value="@modelo.IdEvaluacionModelo" selected="@(modelo.IdEvaluacionModelo == Model.IdEvaluacionModelo)">
                                        @(modelo.CodigoModelo ?? "") - @(modelo.NombreEvaluacion ?? "") (@(modelo.NombreMateria ?? ""))
                                    </option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdEvaluacionModelo" class="text-danger"></span>
                        <small class="form-text text-muted">Seleccione el modelo de evaluación correspondiente</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdPeriodo" class="form-label">Período Académico <span class="text-danger">*</span></label>
                        <select asp-for="IdPeriodo" class="form-select" required>
                            <option value="">Seleccione un período</option>
                            @if (ViewBag.Periodos != null)
                            {
                                @foreach (var periodo in ViewBag.Periodos as List<UmProject.Entities.PeriodoAcademico>)
                                {
                                    <option value="@periodo.IdPeriodo" selected="@(periodo.IdPeriodo == Model.IdPeriodo)">@(periodo.NombrePeriodo ?? "") - @(periodo.CodigoPeriodo ?? "")</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdPeriodo" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaProgramada" class="form-label">Fecha Programada</label>
                        <input asp-for="FechaProgramada" type="datetime-local" class="form-control" value="@(Model.FechaProgramada?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                        <span asp-validation-for="FechaProgramada" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaLimite" class="form-label">Fecha Límite</label>
                        <input asp-for="FechaLimite" type="datetime-local" class="form-control" value="@(Model.FechaLimite?.ToString("yyyy-MM-ddTHH:mm") ?? "")" />
                        <span asp-validation-for="FechaLimite" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CalificacionMaxima" class="form-label">Calificación Máxima (0 - 100) <span class="text-danger">*</span></label>
                        <input asp-for="CalificacionMaxima" type="number" min="0" max="100" step="0.01" class="form-control" />
                        <span asp-validation-for="CalificacionMaxima" class="text-danger"></span>
                        <small class="form-text text-muted">Puntaje total permitido para esta instancia.</small>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdEstado" class="form-label">Estado <span class="text-danger">*</span></label>
                        <select asp-for="IdEstado" class="form-select" required>
                            <option value="">Seleccione un estado</option>
                            @if (ViewBag.Estados != null)
                            {
                                @foreach (var estado in ViewBag.Estados as List<UmProject.Entities.Estado>)
                                {
                                    <option value="@estado.IdEstado" selected="@(estado.IdEstado == Model.IdEstado)">@estado.NombreEstado</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdEstado" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Requiere Revisión Interna</label>
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" name="RequiereRevisionInterna" id="RequiereRevisionInterna" value="true" checked="@Model.RequiereRevisionInterna" />
                            <input type="hidden" name="RequiereRevisionInterna" value="false" />
                            <label class="form-check-label" for="RequiereRevisionInterna">Sí</label>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="NumeroVersion" class="form-label">Número de Versión</label>
                        <input asp-for="NumeroVersion" type="number" min="1" class="form-control" />
                        <span asp-validation-for="NumeroVersion" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 1.25rem; border-radius: 8px;">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none; padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-save me-2"></i>Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

