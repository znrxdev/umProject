@model UmProject.Entities.SancionAcademica

@{
    ViewData["Title"] = "Nueva Sanción Académica";
    ViewData["Subtitle"] = "Registrar nueva sanción académica";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <a asp-controller="SancionesAcademicas" asp-action="Index">Sanciones Académicas</a>
        <span class="separator">/</span>
        <span>Nueva</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">Nueva Sanción Académica</h1>
            <p class="page-subtitle">Registre una nueva sanción académica</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <div class="card">
        <div class="card-header">
            <h6 class="mb-0"><i class="fas fa-exclamation-triangle me-2"></i>Información de la Sanción</h6>
        </div>
        <div class="card-body">
            <form asp-action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CodigoSancion" class="form-label">Código de Sanción</label>
                        <input asp-for="CodigoSancion" class="form-control" placeholder="Se generará automáticamente si se deja vacío" maxlength="30" />
                        <span asp-validation-for="CodigoSancion" class="text-danger"></span>
                        <small class="form-text text-muted">Deje vacío para generar automáticamente</small>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdEstado" class="form-label">Estado <span class="text-danger">*</span></label>
                        <select asp-for="IdEstado" class="form-select" required>
                            <option value="">Seleccione un estado</option>
                            @if (ViewBag.Estados != null)
                            {
                                @foreach (var estado in ViewBag.Estados as List<UmProject.Entities.Estado>)
                                {
                                    <option value="@estado.IdEstado">@estado.NombreEstado</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdEstado" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdEstudiante" class="form-label">Estudiante <span class="text-danger">*</span></label>
                        <select asp-for="IdEstudiante" class="form-select" required>
                            <option value="">Seleccione un estudiante</option>
                            @if (ViewBag.Estudiantes != null)
                            {
                                @foreach (var estudiante in ViewBag.Estudiantes as List<UmProject.Entities.Estudiante>)
                                {
                                    <option value="@estudiante.IdUsuario">@(estudiante.NombreCompleto ?? "") - @(estudiante.Usuario ?? "")</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdEstudiante" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdTipoSancion" class="form-label">Tipo de Sanción <span class="text-danger">*</span></label>
                        <select asp-for="IdTipoSancion" class="form-select" required>
                            <option value="">Seleccione un tipo de sanción</option>
                            @if (ViewBag.TiposSancion != null)
                            {
                                @foreach (var tipo in ViewBag.TiposSancion as List<UmProject.Entities.Catalogo>)
                                {
                                    <option value="@tipo.IdCatalogo">@tipo.NombreCatalogo</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdTipoSancion" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdTipoFalta" class="form-label">Tipo de Falta</label>
                        <select asp-for="IdTipoFalta" class="form-select">
                            <option value="">Seleccione un tipo de falta (opcional)</option>
                            @if (ViewBag.TiposFalta != null)
                            {
                                @foreach (var tipo in ViewBag.TiposFalta as List<UmProject.Entities.Catalogo>)
                                {
                                    <option value="@tipo.IdCatalogo">@tipo.NombreCatalogo</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdTipoFalta" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdSeveridad" class="form-label">Severidad <span class="text-danger">*</span></label>
                        <select asp-for="IdSeveridad" class="form-select" required>
                            <option value="">Seleccione una severidad</option>
                            @if (ViewBag.Severidades != null)
                            {
                                @foreach (var severidad in ViewBag.Severidades as List<UmProject.Entities.Catalogo>)
                                {
                                    <option value="@severidad.IdCatalogo">@severidad.NombreCatalogo</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdSeveridad" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaRegistro" class="form-label">Fecha de Registro <span class="text-danger">*</span></label>
                        <input asp-for="FechaRegistro" type="datetime-local" class="form-control" required />
                        <span asp-validation-for="FechaRegistro" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaFin" class="form-label">Fecha de Fin</label>
                        <input asp-for="FechaFin" type="datetime-local" class="form-control" />
                        <span asp-validation-for="FechaFin" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="Motivo" class="form-label">Motivo</label>
                        <textarea asp-for="Motivo" class="form-control" rows="3" placeholder="Motivo de la sanción..." maxlength="300"></textarea>
                        <span asp-validation-for="Motivo" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label class="form-label">Es Apelable</label>
                        <div class="form-check form-switch">
                            <input type="checkbox" class="form-check-input" name="EsApelable" id="EsApelable" value="true" />
                            <input type="hidden" name="EsApelable" value="false" />
                            <label class="form-check-label" for="EsApelable">Sí</label>
                        </div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdUsuarioResolucion" class="form-label">Usuario de Resolución</label>
                        <select asp-for="IdUsuarioResolucion" class="form-select">
                            <option value="">Seleccione un usuario (opcional)</option>
                            @if (ViewBag.UsuariosResolucion != null)
                            {
                                @foreach (var usuario in ViewBag.UsuariosResolucion as List<UmProject.Entities.Usuario>)
                                {
                                    <option value="@usuario.IdUsuario">@(usuario.NombreCompleto ?? "") - @(usuario.UsuarioNombre ?? "")</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdUsuarioResolucion" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="FechaResolucion" class="form-label">Fecha de Resolución</label>
                        <input asp-for="FechaResolucion" type="datetime-local" class="form-control" />
                        <span asp-validation-for="FechaResolucion" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="DocumentoResolucion" class="form-label">Documento de Resolución</label>
                        <input asp-for="DocumentoResolucion" class="form-control" placeholder="Nombre del documento..." maxlength="255" />
                        <span asp-validation-for="DocumentoResolucion" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="ObservacionesApelacion" class="form-label">Observaciones de Apelación</label>
                        <textarea asp-for="ObservacionesApelacion" class="form-control" rows="2" placeholder="Observaciones sobre la apelación (si aplica)..." maxlength="500"></textarea>
                        <span asp-validation-for="ObservacionesApelacion" class="text-danger"></span>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 1.25rem; border-radius: 8px;">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none; padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-save me-2"></i>Guardar Sanción
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

