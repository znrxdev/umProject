@model UmProject.Entities.Usuario

@{
    ViewData["Title"] = "Detalles del Usuario";
    ViewData["Subtitle"] = "Información detallada";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Información del Usuario</h6>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.IdUsuario" class="btn btn-sm btn-warning">
                <i class="fas fa-edit me-1"></i>Editar
            </a>
            <a asp-action="Index" class="btn btn-sm btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
        </div>
    </div>
    <div class="card-body">
        <h5 class="mb-4">@Model.UsuarioNombre</h5>
        
        <div class="row">
            <div class="col-md-6">
                <h6 class="text-primary mb-3">Información General</h6>
                <dl class="row">
                    <dt class="col-sm-5">ID Usuario</dt>
                    <dd class="col-sm-7">@Model.IdUsuario</dd>

                    <dt class="col-sm-5">ID Persona</dt>
                    <dd class="col-sm-7">@Model.IdPersona</dd>

                    <dt class="col-sm-5">Usuario</dt>
                    <dd class="col-sm-7"><strong>@Model.UsuarioNombre</strong></dd>

                    <dt class="col-sm-5">Estado</dt>
                    <dd class="col-sm-7">
                        @if (Model.IdEstado == 1)
                        {
                            <span class="badge bg-success">Activo</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactivo</span>
                        }
                    </dd>
                </dl>
            </div>

            <div class="col-md-6">
                <h6 class="text-primary mb-3">Información de Sesión</h6>
                <dl class="row">
                    <dt class="col-sm-5">Última Sesión</dt>
                    <dd class="col-sm-7">@(Model.UltimaSesion ?? "-")</dd>

                    <dt class="col-sm-5">Último Cambio Contraseña</dt>
                    <dd class="col-sm-7">@(Model.UltimoCambioContrasena ?? "-")</dd>

                    <dt class="col-sm-5">Fecha Creación</dt>
                    <dd class="col-sm-7">@Model.FechaCreacion</dd>

                    <dt class="col-sm-5">Fecha Modificación</dt>
                    <dd class="col-sm-7">@Model.FechaModificacion</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

