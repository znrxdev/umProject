@model List<UmProject.Entities.Usuario>

@if (Model != null && Model.Any())
{
    <table class="modern-table">
        <thead>
            <tr>
                <th>Usuario</th>
                <th>Estado</th>
                <th>Última Sesión</th>
                <th>Último Cambio</th>
                <th>Auditoría</th>
                <th style="text-align: right;">Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var usuario in Model)
            {
                var iniciales = usuario.UsuarioNombre?.Length > 0 
                    ? usuario.UsuarioNombre.Substring(0, Math.Min(2, usuario.UsuarioNombre.Length)).ToUpper() 
                    : "U";
                
                <tr>
                    <td>
                        <div class="user-info-cell">
                            <div class="user-avatar-small">@iniciales</div>
                            <div class="user-details">
                                <div class="user-name">@usuario.UsuarioNombre</div>
                                <div class="user-role">ID: @usuario.IdUsuario</div>
                            </div>
                        </div>
                    </td>
                    <td>
                        @if (usuario.IdEstado == 1)
                        {
                            <span class="status-badge active">
                                <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem;"></i>Activo
                            </span>
                        }
                        else
                        {
                            <span class="status-badge inactive">
                                <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem;"></i>Inactivo
                            </span>
                        }
                    </td>
                    <td>
                        <div style="font-size: 0.875rem; color: var(--text-primary);">@(usuario.UltimaSesion ?? "Nunca")</div>
                    </td>
                    <td>
                        <div style="font-size: 0.875rem; color: var(--text-primary);">@(usuario.UltimoCambioContrasena ?? "N/A")</div>
                    </td>
                    <td>
                        <div class="audit-info">
                            <i class="fas fa-clock" style="font-size: 0.75rem;"></i>
                            <span>Creado: @usuario.FechaCreacion</span>
                        </div>
                    </td>
                    <td style="text-align: right;">
                        <div class="action-buttons">
                            <a asp-action="Details" asp-route-id="@usuario.IdUsuario" class="btn-icon btn-view" title="Ver detalles">
                                <i class="fas fa-eye"></i>
                            </a>
                            <a href="#" class="btn-icon btn-edit btnEditarUsuario" data-id-usuario="@usuario.IdUsuario" title="Editar">
                                <i class="fas fa-edit"></i>
                            </a>
                        </div>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}
else
{
    <div class="empty-state">
        <i class="fas fa-inbox"></i>
        <h3>No se encontraron usuarios</h3>
        <p>Intente ajustar los filtros de búsqueda</p>
    </div>
}

