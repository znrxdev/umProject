@{
    Layout = null;
}

<div class="modal fade" id="modalDecisionUsuario" tabindex="-1" aria-labelledby="modalDecisionUsuarioLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalDecisionUsuarioLabel">
                    <i class="fas fa-user-cog me-2"></i>Decisión de Usuario
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <div id="contenidoDecision">
                    <!-- El contenido se carga dinámicamente -->
                </div>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
            </div>
        </div>
    </div>
</div>

