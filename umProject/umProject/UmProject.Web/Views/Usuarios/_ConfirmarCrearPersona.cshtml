@{
    Layout = null;
}

<div class="modal fade" id="modalConfirmarCrearPersona" tabindex="-1" aria-labelledby="modalConfirmarCrearPersonaLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title" id="modalConfirmarCrearPersonaLabel">
                    <i class="fas fa-exclamation-triangle me-2"></i>Persona No Encontrada
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body text-center py-4">
                <i class="fas fa-user-times fa-3x text-warning mb-3"></i>
                <h5 class="mb-3">La persona no existe en el sistema</h5>
                <p class="text-muted mb-4">¿Desea crear una nueva persona con el documento <strong id="documentoMostrar"></strong>?</p>
            </div>
            <div class="modal-footer justify-content-center">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" id="btnConfirmarCrearPersona">
                    <i class="fas fa-check me-2"></i>Sí, Crear Persona
                </button>
            </div>
        </div>
    </div>
</div>

