@model UmProject.Entities.BecaPrograma

@{
    ViewData["Title"] = "Editar Programa de Beca";
    ViewData["Subtitle"] = "Modificar información de programa de beca";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <a asp-controller="ProgramasBecas" asp-action="Index">Programas de Becas</a>
        <span class="separator">/</span>
        <span>Editar</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">Editar Programa de Beca</h1>
            <p class="page-subtitle">Modifique la información del programa de beca</p>
        </div>
        <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
            <i class="fas fa-arrow-left me-2"></i>Volver
        </a>
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <div class="card">
        <div class="card-header">
            <h6 class="mb-0"><i class="fas fa-graduation-cap me-2"></i>Información del Programa</h6>
        </div>
        <div class="card-body">
            <form asp-action="Edit" method="post">
                <input type="hidden" asp-for="IdBecaPrograma" />
                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="CodigoPrograma" class="form-label">Código del Programa</label>
                        <input asp-for="CodigoPrograma" class="form-control" maxlength="30" readonly />
                        <span asp-validation-for="CodigoPrograma" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="NombrePrograma" class="form-label">Nombre del Programa <span class="text-danger">*</span></label>
                        <input asp-for="NombrePrograma" class="form-control" required maxlength="150" />
                        <span asp-validation-for="NombrePrograma" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-12 mb-3">
                        <label asp-for="Descripcion" class="form-label">Descripción</label>
                        <textarea asp-for="Descripcion" class="form-control" rows="3" placeholder="Descripción del programa de beca..." maxlength="500"></textarea>
                        <span asp-validation-for="Descripcion" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdTipoPrograma" class="form-label">Tipo de Programa</label>
                        <select asp-for="IdTipoPrograma" class="form-select">
                            <option value="">Seleccione un tipo de programa (opcional)</option>
                            @if (ViewBag.TiposPrograma != null)
                            {
                                @foreach (var tipo in ViewBag.TiposPrograma as List<UmProject.Entities.Catalogo>)
                                {
                                    <option value="@tipo.IdCatalogo" selected="@(tipo.IdCatalogo == Model.IdTipoPrograma)">@tipo.NombreCatalogo</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdTipoPrograma" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="IdModalidadPrograma" class="form-label">Modalidad del Programa</label>
                        <select asp-for="IdModalidadPrograma" class="form-select">
                            <option value="">Seleccione una modalidad (opcional)</option>
                            @if (ViewBag.ModalidadesPrograma != null)
                            {
                                @foreach (var modalidad in ViewBag.ModalidadesPrograma as List<UmProject.Entities.Catalogo>)
                                {
                                    <option value="@modalidad.IdCatalogo" selected="@(modalidad.IdCatalogo == Model.IdModalidadPrograma)">@modalidad.NombreCatalogo</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdModalidadPrograma" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-4 mb-3">
                        <label asp-for="PromedioMinimo" class="form-label">Promedio Mínimo</label>
                        <input asp-for="PromedioMinimo" type="number" step="0.01" min="0" max="100" class="form-control" />
                        <span asp-validation-for="PromedioMinimo" class="text-danger"></span>
                    </div>
                </div>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="IdEstadoPrograma" class="form-label">Estado del Programa <span class="text-danger">*</span></label>
                        <select asp-for="IdEstadoPrograma" class="form-select" required>
                            <option value="">Seleccione un estado</option>
                            @if (ViewBag.Estados != null)
                            {
                                @foreach (var estado in ViewBag.Estados as List<UmProject.Entities.Estado>)
                                {
                                    <option value="@estado.IdEstado" selected="@(estado.IdEstado == Model.IdEstadoPrograma)">@estado.NombreEstado</option>
                                }
                            }
                        </select>
                        <span asp-validation-for="IdEstadoPrograma" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label">Opciones</label>
                        <div class="form-check form-switch mb-2">
                            <input type="checkbox" class="form-check-input" name="RequiereSinSanciones" id="RequiereSinSanciones" value="true" checked="@Model.RequiereSinSanciones" />
                            <input type="hidden" name="RequiereSinSanciones" value="false" />
                            <label class="form-check-label" for="RequiereSinSanciones">Requiere Sin Sanciones</label>
                        </div>
                    </div>
                </div>

                <div class="d-flex justify-content-end gap-2 mt-4">
                    <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 1.25rem; border-radius: 8px;">
                        <i class="fas fa-times me-2"></i>Cancelar
                    </a>
                    <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none; padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
                        <i class="fas fa-save me-2"></i>Guardar Cambios
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

