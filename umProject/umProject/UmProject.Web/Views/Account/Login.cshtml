@model UmProject.Web.Models.LoginViewModel

@{
    ViewData["Title"] = "Iniciar Sesión";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sistema de Control de Evaluaciones Académicas</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
</head>
<body>
    <div class="login-container">
        <div class="login-card">
            <div class="text-center mb-4">
                <img src="~/assets/LogoUmProject.png" alt="Logo" class="login-logo" />
            </div>
            <h3 class="text-center mb-4" style="font-weight: 600; color: var(--text-primary);">Iniciar Sesión</h3>

            @if (!string.IsNullOrEmpty(Model?.MensajeError))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert" style="border-radius: 8px;">
                    @Model.MensajeError
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <form asp-action="Login" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                
                <div class="mb-3">
                    <label asp-for="Usuario" class="form-label" style="font-weight: 500; color: var(--text-primary);">Usuario</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
                            <i class="fas fa-user" style="color: var(--text-secondary);"></i>
                        </span>
                        <input asp-for="Usuario" class="form-control" placeholder="Ingrese su usuario" style="border: 1px solid var(--border-color); border-left: none;" />
                    </div>
                    <span asp-validation-for="Usuario" class="text-danger"></span>
                </div>

                <div class="mb-4">
                    <label asp-for="Contrasena" class="form-label" style="font-weight: 500; color: var(--text-primary);">Contraseña</label>
                    <div class="input-group">
                        <span class="input-group-text" style="background: var(--bg-secondary); border: 1px solid var(--border-color);">
                            <i class="fas fa-lock" style="color: var(--text-secondary);"></i>
                        </span>
                        <input asp-for="Contrasena" type="password" class="form-control" placeholder="Ingrese su contraseña" style="border: 1px solid var(--border-color); border-left: none;" />
                    </div>
                    <span asp-validation-for="Contrasena" class="text-danger"></span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none; padding: 0.75rem; font-weight: 600; border-radius: 8px;">
                        <i class="fas fa-sign-in-alt me-2"></i>Iniciar Sesión
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>

