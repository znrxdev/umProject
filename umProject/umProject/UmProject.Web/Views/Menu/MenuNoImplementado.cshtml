@{
    ViewData["Title"] = ViewBag.NombreMenu ?? "Menú";
    ViewData["Subtitle"] = "Funcionalidad en desarrollo";
}

<div class="container-fluid">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card shadow-sm">
                <div class="card-body text-center py-5">
                    <i class="fas fa-tools fa-4x text-muted mb-4"></i>
                    <h3 class="card-title mb-3">Menú aún no implementado</h3>
                    <p class="text-muted mb-0">La funcionalidad de <strong>@(ViewBag.NombreMenu ?? "este menú")</strong> está en desarrollo y estará disponible próximamente.</p>
                </div>
            </div>
        </div>
    </div>
</div>

