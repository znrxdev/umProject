@model List<UmProject.Entities.PeriodoAcademico>

@{
    ViewData["Title"] = "Gestión de Períodos Académicos";
    ViewData["Subtitle"] = "Administración de períodos académicos";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <span>Períodos Académicos</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">Gestión de Períodos Académicos</h1>
            <p class="page-subtitle">Administre y controle los períodos académicos del sistema</p>
        </div>
        <a asp-action="Create" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none; padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
            <i class="fas fa-plus me-2"></i>Nuevo Período
        </a>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="filter-toolbar">
    <div class="search-input-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" placeholder="Buscar por código o nombre de período..." class="form-control" style="border: 1px solid var(--border-color);">
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <div class="modern-table-container">
        @if (Model != null && Model.Any())
        {
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Fecha Inicio</th>
                        <th>Fecha Fin</th>
                        <th>Es Actual</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var periodo in Model)
                    {
                        <tr>
                            <td>@periodo.IdPeriodo</td>
                            <td>
                                <strong style="color: var(--text-primary);">@periodo.CodigoPeriodo</strong>
                            </td>
                            <td>@periodo.NombrePeriodo</td>
                            <td>
                                <div style="font-size: 0.875rem; color: var(--text-primary);">@(periodo.FechaInicio ?? "N/A")</div>
                            </td>
                            <td>
                                <div style="font-size: 0.875rem; color: var(--text-primary);">@(periodo.FechaFin ?? "N/A")</div>
                            </td>
                            <td>
                                @if (periodo.EsPeriodoActual == true)
                                {
                                    <span class="status-badge active">
                                        <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem;"></i>Sí
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">
                                        <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem;"></i>No
                                    </span>
                                }
                            </td>
                            <td>
                                @{
                                    ViewData["IdEstado"] = periodo.IdEstado;
                                    ViewData["NombreEstado"] = periodo.NombreEstado;
                                }
                                @await Html.PartialAsync("_EstadoBadge", periodo)
                            </td>
                            <td style="text-align: right;">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@periodo.IdPeriodo" class="btn-icon btn-view" title="Ver detalles">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@periodo.IdPeriodo" class="btn-icon btn-edit" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-calendar-alt"></i>
                <h3>No hay períodos académicos registrados</h3>
                <p>No se encontraron períodos académicos en el sistema. Agregue un nuevo período para comenzar.</p>
            </div>
        }
    </div>
</div>

<!-- Modal para agregar materias al período creado -->
@if (TempData["PeriodoCreadoId"] != null)
{
    <div class="modal fade" id="modalAgregarMaterias" tabindex="-1" aria-labelledby="modalAgregarMateriasLabel" aria-hidden="true" data-bs-backdrop="static" data-bs-keyboard="false">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); color: white; border-radius: 8px 8px 0 0;">
                    <h5 class="modal-title" id="modalAgregarMateriasLabel">
                        <i class="fas fa-book me-2"></i>¿Agregar Materias al Período?
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body" style="padding: 2rem;">
                    <div class="text-center mb-4">
                        <i class="fas fa-question-circle fa-3x mb-3" style="color: var(--primary-color);"></i>
                        <h5 class="mb-3">Período creado exitosamente</h5>
                        <p class="text-muted mb-0">
                            El período <strong>@TempData["PeriodoCreadoNombre"]</strong> ha sido creado correctamente.
                        </p>
                        <p class="text-muted mt-3 mb-0">
                            ¿Desea agregar materias a este período académico ahora?
                        </p>
                    </div>
                </div>
                <div class="modal-footer" style="border-top: 1px solid var(--border-color); padding: 1rem 2rem;">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        <i class="fas fa-times me-2"></i>Ahora no
                    </button>
                    <a href="@Url.Action("Edit", "PeriodosAcademicos", new { id = TempData["PeriodoCreadoId"], tab = "materias" })" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none;">
                        <i class="fas fa-book me-2"></i>Sí, agregar materias
                    </a>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script>
        $(document).ready(function() {
            // Búsqueda en tiempo real
            $('#searchInput').on('input', function() {
                var searchText = $(this).val().toLowerCase();
                $('.modern-table tbody tr').each(function() {
                    var rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.includes(searchText));
                });
            });

            // Mostrar modal si hay un período recién creado
            @if (TempData["PeriodoCreadoId"] != null)
            {
                <text>
                var modalAgregarMaterias = new bootstrap.Modal(document.getElementById('modalAgregarMaterias'));
                modalAgregarMaterias.show();
                </text>
            }
        });
    </script>
}

