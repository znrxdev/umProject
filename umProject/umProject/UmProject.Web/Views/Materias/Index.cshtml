@model List<UmProject.Entities.Materia>

@{
    ViewData["Title"] = "Gestión de Materias";
    ViewData["Subtitle"] = "Administración de materias académicas";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <span>Materias</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">Gestión de Materias</h1>
            <p class="page-subtitle">Administre y controle las materias académicas del sistema</p>
        </div>
        <a asp-action="Create" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none; padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
            <i class="fas fa-plus me-2"></i>Nueva Materia
        </a>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="filter-toolbar">
    <div class="search-input-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" placeholder="Buscar por código o nombre de materia..." class="form-control" style="border: 1px solid var(--border-color);">
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <div class="modern-table-container">
        @if (Model != null && Model.Any())
        {
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Código</th>
                        <th>Nombre</th>
                        <th>Fecha Creación</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var materia in Model)
                    {
                        <tr>
                            <td>@materia.IdMateria</td>
                            <td>
                                <strong style="color: var(--text-primary);">@materia.CodigoMateria</strong>
                            </td>
                            <td>@materia.NombreMateria</td>
                            <td>
                                <div style="font-size: 0.875rem; color: var(--text-primary);">@(materia.FechaCreacion ?? "N/A")</div>
                            </td>
                            <td>
                                @if (materia.Activo == true)
                                {
                                    <span class="status-badge active">
                                        <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem;"></i>Activa
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge inactive">
                                        <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem;"></i>Inactiva
                                    </span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@materia.IdMateria" class="btn-icon btn-view" title="Ver detalles">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@materia.IdMateria" class="btn-icon btn-edit" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-book"></i>
                <h3>No hay materias registradas</h3>
                <p>No se encontraron materias en el sistema. Agregue una nueva materia para comenzar.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Búsqueda en tiempo real
            $('#searchInput').on('input', function() {
                var searchText = $(this).val().toLowerCase();
                $('.modern-table tbody tr').each(function() {
                    var rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.includes(searchText));
                });
            });
        });
    </script>
}
