@model UmProject.Entities.Materia

@{
    ViewData["Title"] = "Detalles de Materia";
    ViewData["Subtitle"] = "Información detallada";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Información de la Materia</h6>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.IdMateria" class="btn btn-sm btn-warning">
                <i class="fas fa-edit me-1"></i>Editar
            </a>
            <a asp-action="Index" class="btn btn-sm btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
        </div>
    </div>
    <div class="card-body">
        <dl class="row">
            <dt class="col-sm-3">ID Materia</dt>
            <dd class="col-sm-9">@Model.IdMateria</dd>

            <dt class="col-sm-3">Código</dt>
            <dd class="col-sm-9"><strong>@Model.CodigoMateria</strong></dd>

            <dt class="col-sm-3">Nombre</dt>
            <dd class="col-sm-9">@Model.NombreMateria</dd>

            <dt class="col-sm-3">Estado</dt>
            <dd class="col-sm-9">
                @if (Model.Activo == true)
                {
                    <span class="badge bg-success">Activa</span>
                }
                else
                {
                    <span class="badge bg-danger">Inactiva</span>
                }
            </dd>

            <dt class="col-sm-3">Fecha Creación</dt>
            <dd class="col-sm-9">@Model.FechaCreacion</dd>

            <dt class="col-sm-3">Fecha Modificación</dt>
            <dd class="col-sm-9">@Model.FechaModificacion</dd>
        </dl>
    </div>
</div>

