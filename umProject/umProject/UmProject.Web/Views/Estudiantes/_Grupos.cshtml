@model List<UmProject.Entities.EstudianteGrupo>

@if (Model != null && Model.Any())
{
    <div class="modern-table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Período</th>
                    <th>Tipo</th>
                    <th>Jornada</th>
                    <th>Coordinador</th>
                    <th>Rol en Grupo</th>
                    <th>Es Delegado</th>
                    <th>Estado</th>
                    <th>Fecha Asignación</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var grupo in Model)
                {
                    <tr>
                        <td>@grupo.CodigoGrupo</td>
                        <td>@grupo.NombreGrupo</td>
                        <td>@grupo.NombrePeriodo</td>
                        <td>@grupo.TipoGrupo</td>
                        <td>@grupo.Jornada</td>
                        <td>@grupo.Coordinador</td>
                        <td>@grupo.RolEnGrupo</td>
                        <td>
                            @if (grupo.EsDelegado)
                            {
                                <span class="badge bg-primary">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td>
                            @if (grupo.EstadoGrupo != null && grupo.EstadoGrupo.Trim().Equals("ACTIVO", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status-badge active">
                                    <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #10b981;"></i>@grupo.EstadoGrupo
                                </span>
                            }
                            else
                            {
                                <span class="status-badge inactive">
                                    <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #ef4444;"></i>@grupo.EstadoGrupo
                                </span>
                            }
                        </td>
                        <td>@(grupo.FechaAsignacion?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-users-cog"></i>
        <h3>No hay grupos</h3>
        <p>El estudiante no está asignado a ningún grupo.</p>
    </div>
}

