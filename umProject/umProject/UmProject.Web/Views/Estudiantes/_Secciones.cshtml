@model List<UmProject.Entities.EstudianteSeccion>

@if (Model != null && Model.Any())
{
    <div class="modern-table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Materia</th>
                    <th>Período</th>
                    <th>Docente</th>
                    <th>Tipo</th>
                    <th>Aula</th>
                    <th>Modalidad</th>
                    <th>Cupo</th>
                    <th>Asistencia Mínima</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var seccion in Model)
                {
                    <tr>
                        <td>@seccion.CodigoSeccion</td>
                        <td>@seccion.NombreMateria (@seccion.CodigoMateria)</td>
                        <td>@seccion.NombrePeriodo</td>
                        <td>@seccion.Docente</td>
                        <td>@seccion.TipoSeccion</td>
                        <td>@seccion.Aula</td>
                        <td>@seccion.Modalidad</td>
                        <td>@seccion.CupoMaximo</td>
                        <td>@(seccion.PorcentajeAsistenciaMinima?.ToString("F2") + "%" ?? "N/A")</td>
                        <td>
                            @if (seccion.EstadoSeccion != null && seccion.EstadoSeccion.Trim().Equals("ACTIVO", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status-badge active">
                                    <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #10b981;"></i>@seccion.EstadoSeccion
                                </span>
                            }
                            else
                            {
                                <span class="status-badge inactive">
                                    <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #ef4444;"></i>@seccion.EstadoSeccion
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-layer-group"></i>
        <h3>No hay secciones</h3>
        <p>El estudiante no está inscrito en ninguna sección.</p>
    </div>
}

