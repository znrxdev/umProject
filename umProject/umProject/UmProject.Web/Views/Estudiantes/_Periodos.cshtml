@model List<UmProject.Entities.EstudiantePeriodo>

@if (Model != null && Model.Any())
{
    <div class="modern-table-container">
        <table class="modern-table">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Tipo</th>
                    <th>Fecha Inicio</th>
                    <th>Fecha Fin</th>
                    <th>Es Actual</th>
                    <th>Total Inscripciones</th>
                    <th>Estado</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var periodo in Model)
                {
                    <tr>
                        <td>@periodo.CodigoPeriodo</td>
                        <td>@periodo.NombrePeriodo</td>
                        <td>@periodo.TipoPeriodo</td>
                        <td>@(periodo.FechaInicio?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        <td>@(periodo.FechaFin?.ToString("dd/MM/yyyy") ?? "N/A")</td>
                        <td>
                            @if (periodo.EsPeriodoActual)
                            {
                                <span class="badge bg-success">Sí</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">No</span>
                            }
                        </td>
                        <td><span class="badge bg-primary">@periodo.TotalInscripciones</span></td>
                        <td>
                            @if (periodo.EstadoPeriodo != null && periodo.EstadoPeriodo.Trim().Equals("ACTIVO", StringComparison.OrdinalIgnoreCase))
                            {
                                <span class="status-badge active">
                                    <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #10b981;"></i>@periodo.EstadoPeriodo
                                </span>
                            }
                            else
                            {
                                <span class="status-badge inactive">
                                    <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem; color: #ef4444;"></i>@periodo.EstadoPeriodo
                                </span>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
else
{
    <div class="empty-state">
        <i class="fas fa-calendar-alt"></i>
        <h3>No hay períodos</h3>
        <p>El estudiante no tiene períodos académicos registrados.</p>
    </div>
}

