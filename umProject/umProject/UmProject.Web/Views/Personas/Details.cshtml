@model UmProject.Entities.Persona

@{
    ViewData["Title"] = "Detalles de Persona";
    ViewData["Subtitle"] = "Información detallada";
    var nombreCompleto = $"{Model.PrimerNombre} {Model.SegundoNombre} {Model.PrimerApellido} {Model.SegundoApellido}";
}

<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Información de la Persona</h6>
        <div>
            <a asp-action="Edit" asp-route-id="@Model.IdPersona" class="btn btn-sm btn-warning">
                <i class="fas fa-edit me-1"></i>Editar
            </a>
            <a asp-action="Index" class="btn btn-sm btn-secondary">
                <i class="fas fa-arrow-left me-1"></i>Volver
            </a>
        </div>
    </div>
    <div class="card-body">
        <h5 class="mb-4">@nombreCompleto</h5>
        
        <div class="row">
            <div class="col-md-6">
                <h6 class="text-primary mb-3">Datos Personales</h6>
                <dl class="row">
                    <dt class="col-sm-5">ID Persona</dt>
                    <dd class="col-sm-7">@Model.IdPersona</dd>

                    <dt class="col-sm-5">Primer Nombre</dt>
                    <dd class="col-sm-7">@Model.PrimerNombre</dd>

                    <dt class="col-sm-5">Segundo Nombre</dt>
                    <dd class="col-sm-7">@(Model.SegundoNombre ?? "-")</dd>

                    <dt class="col-sm-5">Primer Apellido</dt>
                    <dd class="col-sm-7">@Model.PrimerApellido</dd>

                    <dt class="col-sm-5">Segundo Apellido</dt>
                    <dd class="col-sm-7">@(Model.SegundoApellido ?? "-")</dd>

                    <dt class="col-sm-5">Fecha de Nacimiento</dt>
                    <dd class="col-sm-7">@(Model.FechaNacimiento != null ? DateTime.Parse(Model.FechaNacimiento).ToString("dd/MM/yyyy") : "-")</dd>
                </dl>
            </div>

            <div class="col-md-6">
                <h6 class="text-primary mb-3">Documentación</h6>
                <dl class="row">
                    <dt class="col-sm-5">Número de Documento</dt>
                    <dd class="col-sm-7"><strong>@Model.ValorDocumento</strong></dd>

                    <dt class="col-sm-5">Estado</dt>
                    <dd class="col-sm-7">
                        @if (Model.IdEstado == 1)
                        {
                            <span class="badge bg-success">Activa</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactiva</span>
                        }
                    </dd>

                    <dt class="col-sm-5">Fecha Creación</dt>
                    <dd class="col-sm-7">@Model.FechaCreacion</dd>

                    <dt class="col-sm-5">Fecha Modificación</dt>
                    <dd class="col-sm-7">@Model.FechaModificacion</dd>
                </dl>
            </div>
        </div>
    </div>
</div>

