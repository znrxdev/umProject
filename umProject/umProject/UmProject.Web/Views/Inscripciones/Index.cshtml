@model List<UmProject.Entities.Inscripcion>

@{
    ViewData["Title"] = "Gestión de Inscripciones";
    ViewData["Subtitle"] = "Administración de inscripciones académicas";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <span>Inscripciones</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">Gestión de Inscripciones</h1>
            <p class="page-subtitle">Administre y controle las inscripciones académicas del sistema</p>
        </div>
        <a asp-action="Create" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none; padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
            <i class="fas fa-plus me-2"></i>Nueva Inscripción
        </a>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="filter-toolbar">
    <div class="search-input-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" placeholder="Buscar por código, estudiante, materia, período..." class="form-control" style="border: 1px solid var(--border-color);">
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <div class="modern-table-container">
        @if (Model != null && Model.Any())
        {
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Código</th>
                        <th>Estudiante</th>
                        <th>Tipo</th>
                        <th>Estado</th>
                        <th>Fecha Creación</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inscripcion in Model)
                    {
                        <tr>
                            <td>@inscripcion.IdInscripcion</td>
                            <td>
                                <strong style="color: var(--primary-color);">@inscripcion.CodigoInscripcion</strong>
                            </td>
                            <td>
                                <div style="font-weight: 500;">@(inscripcion.EstudianteNombre ?? "N/A")</div>
                                <small class="text-muted">@(inscripcion.EstudianteUsuario ?? "")</small>
                            </td>
                            <td>@(inscripcion.TipoInscripcionNombre ?? "N/A")</td>
                            <td>
                                @{
                                    ViewData["IdEstado"] = inscripcion.IdEstado;
                                    ViewData["NombreEstado"] = inscripcion.EstadoNombre;
                                }
                                @await Html.PartialAsync("_EstadoBadge", inscripcion)
                            </td>
                            <td>@(inscripcion.FechaCreacion ?? "N/A")</td>
                            <td style="text-align: right;">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@inscripcion.IdInscripcion" class="btn-icon btn-view" title="Ver detalles">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                    <a asp-action="Edit" asp-route-id="@inscripcion.IdInscripcion" class="btn-icon btn-edit" title="Editar">
                                        <i class="fas fa-edit"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-clipboard-list"></i>
                <h3>No hay inscripciones registradas</h3>
                <p>No se encontraron inscripciones en el sistema. Agregue una nueva inscripción para comenzar.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Búsqueda en tiempo real
            $('#searchInput').on('input', function() {
                var searchText = $(this).val().toLowerCase();
                $('.modern-table tbody tr').each(function() {
                    var rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.includes(searchText));
                });
            });
        });
    </script>
}

