@model List<UmProject.Entities.EvaluacionAlumno>

@{
    ViewData["Title"] = "Gestión de Evaluaciones";
    ViewData["Subtitle"] = "Administración de evaluaciones académicas";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <span>Evaluaciones</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">Gestión de Evaluaciones</h1>
            <p class="page-subtitle">Administre y controle las evaluaciones académicas del sistema</p>
        </div>
        <a asp-action="Create" class="btn btn-primary" style="background: linear-gradient(135deg, var(--primary-color) 0%, var(--secondary-color) 100%); border: none; padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
            <i class="fas fa-plus me-2"></i>Nueva Evaluación
        </a>
    </div>
</div>

<!-- Filter Toolbar -->
<div class="filter-toolbar">
    <div class="search-input-wrapper">
        <i class="fas fa-search"></i>
        <input type="text" id="searchInput" placeholder="Buscar por código, estudiante, materia, período..." class="form-control" style="border: 1px solid var(--border-color);">
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <div class="modern-table-container">
        @if (Model != null && Model.Any())
        {
            <table class="modern-table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Código</th>
                        <th>Estudiante</th>
                        <th>Materia</th>
                        <th>Período</th>
                        <th>Evaluación</th>
                        <th>Puntaje</th>
                        <th>Porcentaje</th>
                        <th>Estado</th>
                        <th style="text-align: right;">Acciones</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var evaluacion in Model)
                    {
                        <tr>
                            <td>@evaluacion.IdEvaluacionAlumno</td>
                            <td>
                                <strong style="color: var(--primary-color);">@evaluacion.CodigoRegistro</strong>
                            </td>
                            <td>
                                <div style="font-weight: 500;">@(evaluacion.EstudianteNombre ?? "N/A")</div>
                                <small class="text-muted">@(evaluacion.EstudianteUsuario ?? "")</small>
                            </td>
                            <td>
                                <div style="font-size: 0.875rem;">@(evaluacion.NombreMateria ?? "N/A")</div>
                                <small class="text-muted">@(evaluacion.CodigoMateria ?? "")</small>
                            </td>
                            <td>
                                <div style="font-size: 0.875rem;">@(evaluacion.NombrePeriodo ?? "N/A")</div>
                                <small class="text-muted">@(evaluacion.CodigoPeriodo ?? "")</small>
                            </td>
                            <td>@(evaluacion.NombreModeloEvaluacion ?? "N/A")</td>
                            <td>
                                <span class="badge bg-info">@evaluacion.PuntajeObtenido.ToString("F2")</span>
                            </td>
                            <td>
                                @if (evaluacion.PorcentajeLogrado.HasValue)
                                {
                                    <span class="badge bg-success">@evaluacion.PorcentajeLogrado.Value.ToString("F2")%</span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td>
                                @if (!string.IsNullOrEmpty(evaluacion.EstadoNombre))
                                {
                                    <span class="status-badge active">
                                        <i class="fas fa-circle" style="font-size: 0.5rem; margin-right: 0.375rem;"></i>@evaluacion.EstadoNombre
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">N/A</span>
                                }
                            </td>
                            <td style="text-align: right;">
                                <div class="action-buttons">
                                    <a asp-action="Details" asp-route-id="@evaluacion.IdEvaluacionAlumno" class="btn-icon btn-view" title="Ver detalles">
                                        <i class="fas fa-eye"></i>
                                    </a>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <div class="empty-state">
                <i class="fas fa-clipboard-check"></i>
                <h3>No hay evaluaciones registradas</h3>
                <p>No se encontraron evaluaciones en el sistema. Agregue una nueva evaluación para comenzar.</p>
            </div>
        }
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            // Búsqueda en tiempo real
            $('#searchInput').on('input', function() {
                var searchText = $(this).val().toLowerCase();
                $('.modern-table tbody tr').each(function() {
                    var rowText = $(this).text().toLowerCase();
                    $(this).toggle(rowText.includes(searchText));
                });
            });
        });
    </script>
}

