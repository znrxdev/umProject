    function eliminarInscripcion(idGrupoInscripcion, idGrupo) {
        if (confirm('¿Está seguro de que desea eliminar esta inscripción del grupo?')) {
            // TODO: Implementar eliminación
            alert('Funcionalidad de eliminación pendiente de implementar');
        }
    }
</script>

