@model UmProject.Entities.Grupo

@{
    ViewData["Title"] = "Detalles de Grupo";
    ViewData["Subtitle"] = "Información detallada";
}

<!-- Page Header -->
<div class="page-header">
    <nav class="breadcrumb-modern">
        <a asp-controller="Home" asp-action="Index">Dashboard</a>
        <span class="separator">/</span>
        <a asp-controller="Grupos" asp-action="Index">Grupos</a>
        <span class="separator">/</span>
        <span>Detalles</span>
    </nav>
    <div class="page-title-section">
        <div>
            <h1 class="page-title">@Model.NombreGrupo</h1>
            <p class="page-subtitle">@Model.CodigoGrupo - @(Model.NombreTipoGrupo ?? "N/A")</p>
        </div>
        <div class="d-flex gap-2">
            <a asp-action="Edit" asp-route-id="@Model.IdGrupo" class="btn btn-warning" style="padding: 0.625rem 1.25rem; border-radius: 8px; font-weight: 600;">
                <i class="fas fa-edit me-2"></i>Editar
            </a>
            <a asp-action="Index" class="btn btn-secondary" style="padding: 0.625rem 1.25rem; border-radius: 8px;">
                <i class="fas fa-arrow-left me-2"></i>Volver a la Lista
            </a>
        </div>
    </div>
</div>

<!-- Content Container -->
<div class="content-container">
    <div class="row g-4">
        <!-- Información Principal -->
        <div class="col-lg-8">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-info-circle me-2"></i>Detalles del Grupo</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-4 detail-label">Código:</dt>
                        <dd class="col-sm-8 detail-value"><strong>@Model.CodigoGrupo</strong></dd>

                        <dt class="col-sm-4 detail-label">Nombre:</dt>
                        <dd class="col-sm-8 detail-value">@Model.NombreGrupo</dd>

                        <dt class="col-sm-4 detail-label">Tipo de Grupo:</dt>
                        <dd class="col-sm-8 detail-value">@(Model.NombreTipoGrupo ?? "N/A")</dd>

                        <dt class="col-sm-4 detail-label">Período Académico:</dt>
                        <dd class="col-sm-8 detail-value">
                            @(Model.NombrePeriodo ?? "N/A") (@(Model.CodigoPeriodo ?? ""))
                        </dd>

                        <dt class="col-sm-4 detail-label">Estado:</dt>
                        <dd class="col-sm-8 detail-value">
                            @{
                                ViewData["IdEstado"] = Model.IdEstado;
                                ViewData["NombreEstado"] = Model.NombreEstado;
                            }
                            @await Html.PartialAsync("_EstadoBadge", Model)
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Información Adicional -->
        <div class="col-lg-4">
            <div class="card h-100">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-user-tie me-2"></i>Coordinación</h6>
                </div>
                <div class="card-body">
                    <dl class="row mb-0">
                        <dt class="col-sm-6 detail-label">Coordinador:</dt>
                        <dd class="col-sm-6 detail-value">
                            @if (!string.IsNullOrEmpty(Model.CoordinadorNombre))
                            {
                                <div>@Model.CoordinadorNombre</div>
                                <small class="text-muted">@(Model.CoordinadorUsuario ?? "")</small>
                            }
                            else
                            {
                                <span class="text-muted">Sin asignar</span>
                            }
                        </dd>

                        <dt class="col-sm-6 detail-label">Jornada:</dt>
                        <dd class="col-sm-6 detail-value">
                            @if (!string.IsNullOrEmpty(Model.NombreJornada))
                            {
                                <span class="badge bg-info">@Model.NombreJornada</span>
                            }
                            else
                            {
                                <span class="text-muted">N/A</span>
                            }
                        </dd>

                        <dt class="col-sm-6 detail-label">Código Seguimiento:</dt>
                        <dd class="col-sm-6 detail-value">
                            <code style="font-size: 0.875rem;">@Model.CodigoSeguimiento</code>
                        </dd>
                    </dl>
                </div>
            </div>
        </div>

        <!-- Inscripciones del Grupo -->
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-user-graduate me-2"></i>Inscripciones en el Grupo</h6>
                </div>
                <div class="card-body" id="inscripcionesContainer">
                    <div class="text-center py-5">
                        <div class="spinner-border text-primary" role="status">
                            <span class="visually-hidden">Cargando...</span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Configuración y Auditoría -->
        <div class="col-12">
            <div class="card">
                <div class="card-header">
                    <h6 class="mb-0"><i class="fas fa-cogs me-2"></i>Configuración y Auditoría</h6>
                </div>
                <div class="card-body">
                    <div class="row">
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3">Información Adicional</h6>
                            <dl class="row">
                                <dt class="col-sm-5 detail-label">ID Grupo:</dt>
                                <dd class="col-sm-7 detail-value">@Model.IdGrupo</dd>

                                <dt class="col-sm-5 detail-label">Fecha de Cierre:</dt>
                                <dd class="col-sm-7 detail-value">
                                    @if (Model.FechaCierre.HasValue)
                                    {
                                        <i class="fas fa-calendar-times me-1 text-danger"></i>@Model.FechaCierre.Value.ToString("dd/MM/yyyy HH:mm")
                                    }
                                    else
                                    {
                                        <span class="text-muted">No definida</span>
                                    }
                                </dd>

                                <dt class="col-sm-5 detail-label">Fecha Creación:</dt>
                                <dd class="col-sm-7 detail-value">@(Model.FechaCreacion ?? "N/A")</dd>

                                <dt class="col-sm-5 detail-label">Fecha Modificación:</dt>
                                <dd class="col-sm-7 detail-value">@(Model.FechaModificacion ?? "N/A")</dd>
                            </dl>
                        </div>
                        <div class="col-md-6">
                            <h6 class="text-primary mb-3">Estado del Sistema</h6>
                            <dl class="row">
                                <dt class="col-sm-5 detail-label">Estado:</dt>
                                <dd class="col-sm-7 detail-value">
                                    @{
                                        ViewData["IdEstado"] = Model.IdEstado;
                                        ViewData["NombreEstado"] = Model.NombreEstado;
                                    }
                                    @await Html.PartialAsync("_EstadoBadge", Model)
                                </dd>

                                <dt class="col-sm-5 detail-label">Activo:</dt>
                                <dd class="col-sm-7 detail-value">
                                    @if (Model.Activo == true)
                                    {
                                        <span class="badge bg-success">Sí</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">No</span>
                                    }
                                </dd>
                            </dl>
                        </div>
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Observaciones))
                    {
                        <h6 class="text-primary mt-4 mb-3">Observaciones</h6>
                        <p class="detail-value">@Model.Observaciones</p>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        $(document).ready(function() {
            cargarInscripcionesGrupo(@Model.IdGrupo);
        });

        function cargarInscripcionesGrupo(idGrupo) {
            $.ajax({
                url: '@Url.Action("GetInscripcionesGrupo", "Grupos")',
                type: 'GET',
                data: { idGrupo: idGrupo },
                success: function(data) {
                    $('#inscripcionesContainer').html(data);
                },
                error: function() {
                    $('#inscripcionesContainer').html('<div class="alert alert-danger">Error al cargar las inscripciones del grupo</div>');
                }
            });
        }
    </script>
}
